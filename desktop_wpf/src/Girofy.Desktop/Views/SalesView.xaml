<UserControl x:Class="Girofy.Desktop.Views.SalesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="SalesView_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SaleHistoryRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="27" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Vendas" />
                        <TextBlock Margin="0,4,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Abra uma nova venda em janela separada e finalize o pagamento em outra etapa." />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="170" Height="46"
                            Command="{Binding OpenSaleEditorCommand}"
                            Content="Nova venda - F3" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <Border Grid.Row="2" Padding="12" Background="{DynamicResource ErrorSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="4" Padding="12" Background="{DynamicResource SuccessSurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="6" Padding="28" Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Venda rápida" />
                            <TextBlock Margin="0,6,0,0" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Clique em Nova venda para abrir o pedido em uma janela dedicada." />
                            <TextBlock Margin="0,10,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding CartSummary}" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="180" Height="50"
                                VerticalAlignment="Center"
                                Command="{Binding OpenSaleEditorCommand}"
                                Content="Iniciar venda - F3" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>

                        <Border Margin="0,22,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Vendas do dia/caixa" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,12,0" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="Histórico do dia/caixa atual" />
                                        <Button MinWidth="104" Height="34"
                                                Command="{Binding RefreshHistoryCommand}"
                                                Content="Atualizar"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTodaySales}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Padding="12,10" Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.75*" />
                                                <ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="0.75*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Venda" />
                                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Data" />
                                            <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Vendedor" />
                                            <TextBlock Grid.Column="3" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Total" />
                                            <TextBlock Grid.Column="4" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Pagamento" />
                                            <TextBlock Grid.Column="5" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Ação" />
                                        </Grid>
                                    </Border>
                                    <ListBox MaxHeight="520" ItemsSource="{Binding TodaySales}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="IsHitTestVisible" Value="True" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1,0,1,1"
                                                        Background="{DynamicResource SurfaceBrush}">
                                                    <StackPanel>
                                                        <Button Style="{StaticResource SaleHistoryRowButtonStyle}"
                                                                Command="{Binding DataContext.ToggleTodaySaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Border Padding="12">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="0.75*" />
                                                                        <ColumnDefinition Width="1.35*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="0.95*" />
                                                                        <ColumnDefinition Width="1.2*" />
                                                                        <ColumnDefinition Width="0.75*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="13" FontWeight="Bold"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding NumberText}" />
                                                                    <TextBlock Grid.Column="1" FontSize="13"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding DateText}" />
                                                                    <TextBlock Grid.Column="2" FontSize="13"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding UserName}" />
                                                                    <TextBlock Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding FinalAmountText}" />
                                                                    <TextBlock Grid.Column="4" FontSize="13"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               Text="{Binding PaymentText}" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Column="5">
                                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource InfoBrush}"
                                                                                   Text="{Binding ExpandHint}" />
                                                                        <TextBlock Margin="0,3,0,0" FontSize="10" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource ErrorBrush}"
                                                                                   Text="{Binding StatusText}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Button>

                                                        <Border Margin="12,0,12,12" Padding="16"
                                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                                                BorderThickness="1" CornerRadius="8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Text="Carregando detalhes...">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoadingDetail}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                                                           Text="{Binding DetailError}"
                                                                           TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDetailError}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Grid>
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="16" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <StackPanel>
                                                                        <Border Margin="0,0,0,14" Padding="12"
                                                                                Background="{DynamicResource InfoSurfaceBrush}"
                                                                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel>
                                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="VENDA" />
                                                                                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding NumberText}" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="1">
                                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="DATA E HORA" />
                                                                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DateText}" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2">
                                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="OPERADOR" />
                                                                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding UserName}" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="3">
                                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="CAIXA / STATUS" />
                                                                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                                                                        <Run Text="{Binding Detail.CashRegisterText, Mode=OneWay}" />
                                                                                        <Run Text=" • " />
                                                                                        <Run Text="{Binding PaymentStatusText, Mode=OneWay}" />
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <TextBlock FontSize="16" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   Text="Produtos" />
                                                                        <Border Margin="0,10,0,0" Padding="12"
                                                                                Background="{DynamicResource SurfaceBrush}"
                                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="70" />
                                                                                        <ColumnDefinition Width="110" />
                                                                                        <ColumnDefinition Width="110" />
                                                                                        <ColumnDefinition Width="110" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Produto" />
                                                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Qtd." />
                                                                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Unitário" />
                                                                                    <TextBlock Grid.Column="3" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Subtotal" />
                                                                                    <TextBlock Grid.Column="4" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Lucro final" />
                                                                                </Grid>
                                                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Detail.Items}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                        <ColumnDefinition Width="70" />
                                                                                                        <ColumnDefinition Width="110" />
                                                                                                        <ColumnDefinition Width="110" />
                                                                                                        <ColumnDefinition Width="110" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                                                                                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding QuantityText}" />
                                                                                                    <TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding UnitPriceText}" />
                                                                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                                                                                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding ProfitAmountText}" />
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Row="2">
                                                                        <Border Margin="0,0,0,14" Padding="12"
                            Background="{DynamicResource ErrorSoftBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                                                                                BorderThickness="1" CornerRadius="6">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <StackPanel>
                                                                                <TextBlock FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Text="Venda cancelada" />
                                                                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                                                    <Run Text="Motivo: " /><Run Text="{Binding Detail.CancellationReason, Mode=OneWay}" />
                                                                                </TextBlock>
                                                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                                                                                    <Run Text="Por " /><Run Text="{Binding Detail.CancelledByUserName, Mode=OneWay}" />
                                                                                    <Run Text=" em " /><Run Text="{Binding Detail.CancelledAtText, Mode=OneWay}" />
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <TextBlock FontSize="16" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   Text="Pagamento" />
                                                                        <Border Margin="0,10,0,0" Padding="12"
                                                                                Background="{DynamicResource SurfaceBrush}"
                                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6">
                                                                            <StackPanel>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Subtotal" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Detail.SubtotalText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Desconto" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Detail.DiscountAmountText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Total" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding Detail.FinalAmountText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Pago" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Detail.PaidAmountText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,12">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Troco" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" Text="{Binding Detail.ChangeAmountText}" />
                                                                                </Grid>
                                                                                <Separator Background="{DynamicResource BorderBrush}" />
                                                                                <Grid Margin="0,12,0,0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="Formas" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DetailPaymentsText}" />
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                                            <Button Margin="0,0,10,0"
                                                                                    Command="{Binding DataContext.OpenCancellationPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="Cancelar venda">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding CanBeCancelled}" Value="True" />
                                                                                                    <Condition Binding="{Binding DataContext.CanCancelSales, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </MultiDataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                            <Button Command="{Binding DataContext.ViewHistoricalReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="Ver comprovante"
                                                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Margin="0,12,0,0" HorizontalAlignment="Center" MinWidth="150"
                                            Command="{Binding LoadMoreHistoryCommand}" Content="Carregar mais vendas">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMoreSales}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Padding="0,18"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Carregando histórico...">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHistoryLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12"
                                        Background="{DynamicResource ErrorSurfaceBrush}"
                                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasHistoryError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding HistoryErrorMessage}" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Padding="0,18"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Nenhuma venda encontrada.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowHistoryEmptyState}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Padding="28" Background="{DynamicResource SuccessSurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding ReceiptTitle}" />
                        <TextBlock Margin="0,5,0,22" HorizontalAlignment="Center" FontSize="16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Receipt.SaleNumberText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="TOTAL" />
                                <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}" Text="{Binding Receipt.FinalAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="PAGO" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Receipt.PaidAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="TROCO" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InfoBrush}" Text="{Binding Receipt.ChangeAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="CAIXA" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Receipt.CashRegisterText}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,22,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding ReceiptPaymentsText}" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Receipt.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding QuantityText}" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Receipt.HasStockWarnings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding ReceiptStockWarningsText}" TextWrapping="Wrap" />
                        </Border>
                        <Button Margin="0,22,0,0" Height="52" Command="{Binding NewSaleCommand}"
                                Content="Nova venda - F3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHistoricalReceipt}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="0,22,0,0" Height="52"
                                Command="{Binding CloseHistoricalReceiptCommand}"
                                Content="Voltar ao histórico">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHistoricalReceipt}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Panel.ZIndex="55" Background="{DynamicResource OverlayBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpenCashPromptOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Margin="24" Padding="24" MaxWidth="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Caixa fechado" />
                        <TextBlock Margin="0,4,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Para registrar uma venda, abra o caixa agora. Pressione Enter para confirmar."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="2" Padding="16" Background="{DynamicResource InfoSurfaceBrush}"
                            BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                   Text="Deseja abrir o caixa e continuar para a nova venda?" />
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Valor inicial em caixa" />
                        <TextBox x:Name="OpeningCashInput"
                                 Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OpeningCashInput_PreviewKeyDown"
                                 PreviewTextInput="PaymentTextBox_PreviewTextInput"
                                 DataObject.Pasting="PaymentTextBox_Pasting"
                                 LostKeyboardFocus="PaymentTextBox_LostKeyboardFocus"
                                 Style="{StaticResource TextInputStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Height="46"
                                Command="{Binding CancelOpenCashBeforeSaleCommand}"
                                Content="Não"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Height="46"
                                Command="{Binding ConfirmOpenCashBeforeSaleCommand}"
                                Content="Sim, abrir caixa - Enter"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="{DynamicResource OverlaySoftBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSaleEditorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Margin="32" Padding="24" MaxWidth="1180" MaxHeight="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductStepOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="25" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Nova venda" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Pesquise os produtos, informe a quantidade e monte o pedido." />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="110" Height="42"
                                        Command="{Binding CloseSaleEditorCommand}"
                                        Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <Border Grid.Row="2" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Adicionar produto" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProductSearchInput"
                                                 Grid.ColumnSpan="3"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Buscar produto por nome ou código de barras"
                                                 PreviewKeyDown="ProductSearchInput_PreviewKeyDown"
                                                 Style="{StaticResource TextInputStyle}" />
                                        <Button Grid.Column="2" MinWidth="112" Command="{Binding SearchCommand}"
                                                Content="Pesquisar" Visibility="Collapsed"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                    <Border Grid.Row="4" MaxHeight="248" Padding="6"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ListBox x:Name="SearchSuggestionsList"
                                                 ItemsSource="{Binding SearchResults}"
                                                 SelectedItem="{Binding SelectedSearchProduct, Mode=TwoWay}"
                                                 Focusable="True"
                                                 SelectionMode="Single"
                                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                                 KeyboardNavigation.TabNavigation="Contained"
                                                 PreviewKeyDown="SearchSuggestionsList_PreviewKeyDown"
                                                 PreviewMouseLeftButtonUp="SearchSuggestionsList_PreviewMouseLeftButtonUp"
                                                 MouseDoubleClick="SearchSuggestionsList_MouseDoubleClick"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,6" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="SuggestionItem"
                                                                        Padding="12"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="1"
                                                                        CornerRadius="7"
                                                                        TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SuggestionItem"
                                                                                Property="Background"
                                                                                Value="{DynamicResource SurfaceBrush}" />
                                                                        <Setter TargetName="SuggestionItem"
                                                                                Property="BorderBrush"
                                                                                Value="{DynamicResource BorderBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="SuggestionItem"
                                                                                Property="Background"
                                                                                Value="{DynamicResource AccentSoftBrush}" />
                                                                        <Setter TargetName="SuggestionItem"
                                                                                Property="BorderBrush"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource TextPrimaryBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                        <Setter TargetName="SuggestionItem"
                                                                                Property="Background"
                                                                                Value="{DynamicResource AccentSoftBrush}" />
                                                                        <Setter TargetName="SuggestionItem"
                                                                                Property="BorderBrush"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource TextPrimaryBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="54">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="Auto" MinWidth="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Margin="0,4,0,0"
                                                                        Orientation="Horizontal">
                                                                <TextBlock Text="{Binding CategoryName}"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Text=" · "
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock Text="{Binding StockText}"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SalePriceText}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       TextAlignment="Right" />
                                                            <TextBlock Margin="0,3,0,0"
                                                                       Text="{Binding StockText}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="PRODUTO SELECIONADO" />
                                            <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding SelectedSearchProduct.Name, TargetNullValue='Selecione um resultado'}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="Selecione um produto para informar a quantidade" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Itens do pedido" />
                                    <DataGrid Grid.Row="2" MinHeight="112" MaxHeight="250"
                                              ItemsSource="{Binding CartItems}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" SelectionMode="Single"
                                              EnableRowVirtualization="True"
                                              Background="{DynamicResource SurfaceBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                              VerticalGridLinesBrush="Transparent"
                                              RowBackground="{DynamicResource SurfaceBrush}"
                                  AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                                              RowHeight="54" ColumnHeaderHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Unitário" Binding="{Binding UnitPriceText}" Width="1*" />
                                            <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.8*" />
                                            <DataGridTemplateColumn Header="Quantidade" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Width="34" Height="32" Content="-"
                                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                            <TextBlock Width="54" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" TextAlignment="Center"
                                                                       FontWeight="SemiBold" Text="{Binding Quantity}" />
                                                            <Button Width="34" Height="32" Content="+"
                                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Subtotal" Binding="{Binding LineTotalText}" Width="1*" />
                                            <DataGridTemplateColumn Header="Ação" Width="128">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Height="34" MinWidth="108" Content="Remover"
                                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource DangerButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="TOTAL DO PEDIDO" />
                                    <TextBlock Margin="0,3,0,0" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" Text="{Binding TotalText}" />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="190" Height="52"
                                        Command="{Binding OpenPaymentStepCommand}"
                                        Content="Finalizar pedido - F2" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentStepVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="25" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Finalizar venda" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Informe uma ou mais formas de pagamento. F2 finaliza o pedido." />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="150" Height="42"
                                        Command="{Binding BackToProductsCommand}"
                                        Content="Voltar aos itens" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="3" MinWidth="100" Height="42"
                                        Command="{Binding CloseSaleEditorCommand}"
                                        Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                                <Border Padding="18" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Formas de pagamento" />
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" Text="Dinheiro" />
                                            <TextBox x:Name="MoneyInput"
                                                     Tag="money"
                                                     GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                     PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                     PreviewTextInput="PaymentTextBox_PreviewTextInput"
                                                     DataObject.Pasting="PaymentTextBox_Pasting"
                                                     LostKeyboardFocus="PaymentTextBox_LostKeyboardFocus"
                                                     Text="{Binding MoneyText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4">
                                            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" Text="Pix" />
                                            <TextBox x:Name="PixInput"
                                                     Tag="pix"
                                                     GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                     PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                     PreviewTextInput="PaymentTextBox_PreviewTextInput"
                                                     DataObject.Pasting="PaymentTextBox_Pasting"
                                                     LostKeyboardFocus="PaymentTextBox_LostKeyboardFocus"
                                                     Text="{Binding PixText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="6">
                                            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" Text="Débito" />
                                            <TextBox x:Name="DebitInput"
                                                     Tag="debit"
                                                     GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                     PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                     PreviewTextInput="PaymentTextBox_PreviewTextInput"
                                                     DataObject.Pasting="PaymentTextBox_Pasting"
                                                     LostKeyboardFocus="PaymentTextBox_LostKeyboardFocus"
                                                     Text="{Binding DebitText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="8">
                                            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" Text="Crédito" />
                                            <TextBox x:Name="CreditInput"
                                                     Tag="credit"
                                                     GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                     PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                     PreviewTextInput="PaymentTextBox_PreviewTextInput"
                                                     DataObject.Pasting="PaymentTextBox_Pasting"
                                                     LostKeyboardFocus="PaymentTextBox_LostKeyboardFocus"
                                                     Text="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <Button Grid.Row="10" Height="42"
                                                Command="{Binding OpenDiscountPopupCommand}"
                                                Click="OpenDiscountPopupButton_Click"
                                                Content="Desconto - F3"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Padding="20" Background="{DynamicResource InfoSurfaceBrush}"
                                        BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Subtotal" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Desconto" />
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DiscountAmountText}" />
                                                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding DiscountPercentText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Total" />
                                            <TextBlock Grid.Column="1" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding TotalText}" />
                                        </Grid>
                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Pago" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PaidAmountText}" />
                                        </Grid>
                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Falta" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Text="{Binding MissingAmountText}" />
                                        </Grid>
                                        <Grid Grid.Row="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Troco" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" Text="{Binding ChangeAmountText}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Button Grid.Row="4" Height="54" Command="{Binding FinalizeCommand}"
                                    Content="Finalizar venda - F2" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Background="{DynamicResource OverlayBrush}" Panel.ZIndex="40">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsQuantityPopupOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="560" MaxWidth="560" Margin="24" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Text="Quantidade" />
                            <TextBlock Margin="0,5,0,0" FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding SelectedSearchProduct.Name}" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="84" Height="42"
                                Click="CloseQuantityPopupButton_Click"
                                Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <Border Grid.Row="2" Padding="15,13" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding SelectedSearchProduct.SalePriceText}" />
                            <TextBlock Margin="7,0" FontSize="15"
                                       Foreground="{DynamicResource TextMutedBrush}" Text="·" />
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="estoque " />
                                <Run Text="{Binding SelectedSearchProduct.StockText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,7" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Quantidade do produto" />
                        <TextBox x:Name="QuantityInput" Height="48"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Quantidade do produto"
                                 GotKeyboardFocus="QuantityInput_GotKeyboardFocus"
                                 LostKeyboardFocus="QuantityInput_LostKeyboardFocus"
                                 PreviewKeyDown="QuantityInput_PreviewKeyDown"
                                 PreviewTextInput="QuantityInput_PreviewTextInput"
                                 DataObject.Pasting="QuantityInput_Pasting"
                                 Style="{StaticResource TextInputStyle}" />
                    </StackPanel>
                    <Button Grid.Row="6" Height="50" Click="AddProductButton_Click"
                            Content="Adicionar produto" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Background="{DynamicResource OverlayBrush}" Panel.ZIndex="30">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCancellationPopupOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Margin="24" Padding="24" MaxWidth="580"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding PendingCancellationTitle}" />
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Esta ação preserva o registro financeiro, devolve exatamente o estoque movimentado e fica registrada na auditoria." />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Motivo obrigatório" />
                        <TextBox MinHeight="100" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextInputStyle}" />
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="Descreva o motivo com clareza (máximo de 500 caracteres)." />
                    </StackPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Height="46" Command="{Binding CloseCancellationPopupCommand}"
                                Content="Voltar" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Height="46" Command="{Binding ConfirmCancellationCommand}"
                                Content="Confirmar cancelamento" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="{DynamicResource OverlayBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDiscountPopupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Margin="24" Padding="24" MaxWidth="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Aplicar desconto" />
                        <TextBlock Margin="0,4,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Informe o desconto em reais. A porcentagem é calculada automaticamente." />
                    </StackPanel>

                    <Border Grid.Row="2" Padding="16" Background="{DynamicResource InfoSurfaceBrush}"
                            BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Subtotal" />
                                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Total com desconto" />
                                <TextBlock Grid.Column="1" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Text="{Binding DraftTotalAfterDiscountText}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Valor do desconto" />
                        <TextBox x:Name="DiscountPopupInput"
                                 Text="{Binding DraftDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="DiscountPopupInput_PreviewKeyDown"
                                 Style="{StaticResource TextInputStyle}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Percentual aplicado: " />
                            <Run FontWeight="Bold" Text="{Binding DraftDiscountPercentText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Height="46"
                                Command="{Binding CloseDiscountPopupCommand}"
                                Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Height="46"
                                Command="{Binding ApplyDiscountCommand}"
                                Content="Aplicar desconto"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
