                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock FontWeight="{DynamicResource FontWeightStrong}"
                                                                                       Text="{Binding Name}" TextWrapping="Wrap" />
                                                                            <TextBlock FontSize="{DynamicResource FontSizeTiny}"
                                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding BarcodeText}">
                                                                                <Run Text="Código: " /><Run Text="{Binding BarcodeText, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                                                                            <TextBlock HorizontalAlignment="Right"
