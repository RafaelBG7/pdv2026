<UserControl x:Class="Girofy.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReportTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Relatórios" />
                    <TextBlock Margin="0,4,0,0" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Acompanhe vendas, descontos, pagamentos e lucro por período." />
                    <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                        <Button Command="{Binding ShowSummaryTabCommand}"
                                Content="Resumo geral">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="10,0,0,0"
                                Command="{Binding ShowProductsTabCommand}"
                                Content="Por produto">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductsTabSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border Grid.Row="2" Padding="12"
                    Background="{StaticResource ErrorSurfaceBrush}"
                    BorderBrush="{StaticResource ErrorBorderBrush}"
                    BorderThickness="1" CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="4" Padding="18"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Filtros do período" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Período" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding PeriodOptions}"
                                      SelectedItem="{Binding SelectedPeriod}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Gráfico" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding MetricOptions}"
                                      SelectedItem="{Binding SelectedMetric}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Data inicial" />
                            <TextBox Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="AAAA-MM-DD"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Data final" />
                            <TextBox Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="AAAA-MM-DD"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>

                        <Button Grid.Row="2" Grid.ColumnSpan="7" MinWidth="150"
                                Command="{Binding ApplyFiltersCommand}"
                                Content="Aplicar filtros"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="6" Columns="4">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="VENDAS" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Summary.SalesCountText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding Summary.ItemsCountText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="FATURAMENTO" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"
                                   Text="{Binding Summary.FinalText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding Summary.SubtotalText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="LUCRO" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Text="{Binding Summary.ProfitText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding Summary.DiscountText}" />
                    </StackPanel>
                </Border>
                <Border Padding="16"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="TICKET MÉDIO" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Summary.AverageTicketText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Padding="18"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Snapshot.Chart.MetricLabel}" />
                        <TextBlock Grid.Row="2" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding Snapshot.Chart.PeakText}" />
                        <ItemsControl Grid.Row="4" ItemsSource="{Binding ChartBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding Label}" />
                                        <Border Grid.Column="1" Height="14" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}"
                                                Background="{StaticResource InfoBrush}"
                                                CornerRadius="4" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding AmountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Padding="18"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Formas de pagamento" />
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding PaymentTotals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding AmountText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="18"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Produtos mais vendidos" />
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding TopProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="12"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="6" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding QuantityText}" />
                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding TotalText}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="10" Padding="18"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProductsTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Relatório por produto" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding ProductSnapshot.PeriodDescription}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding ProductPagination.PageText}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Produto" />
                            <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Buscar produto"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Ordenar" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding ProductSortOptions}"
                                      SelectedItem="{Binding SelectedProductSort}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <Button Grid.Column="4" MinWidth="132" Margin="0,24,0,0"
                                Command="{Binding ApplyProductFiltersCommand}"
                                Content="Aplicar"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <UniformGrid Grid.Row="4" Columns="5">
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="PRODUTOS" />
                                <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding ProductSummary.ProductsText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="QUANTIDADE" />
                                <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding ProductSummary.QuantityText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="FATURAMENTO" />
                                <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource InfoBrush}"
                                           Text="{Binding ProductSummary.RevenueText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="CUSTO" />
                                <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding ProductSummary.CostText}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="LUCRO" />
                                <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding ProductSummary.ProfitText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="6" ItemsSource="{Binding ProductRows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserResizeRows="False" SelectionMode="Single"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="Transparent"
                              RowBackground="{StaticResource SurfaceRaisedBrush}"
                          AlternatingRowBackground="{StaticResource AlternatingRowBrush}"
                              RowHeight="54" ColumnHeaderHeight="42">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="1.8*" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="1.1*" />
                            <DataGridTextColumn Header="Vendido" Binding="{Binding QuantityText}" Width="0.8*" />
                            <DataGridTextColumn Header="Faturamento" Binding="{Binding RevenueText}" Width="1*" />
                            <DataGridTextColumn Header="Custo" Binding="{Binding CostText}" Width="0.9*" />
                            <DataGridTextColumn Header="Lucro" Binding="{Binding ProfitText}" Width="0.9*" />
                            <DataGridTextColumn Header="Ticket" Binding="{Binding AverageTicketText}" Width="0.9*" />
                            <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button MinWidth="118"
                                Command="{Binding PreviousProductPageCommand}"
                                Content="Anterior"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding ProductPagination.PageText}" />
                        <Button Grid.Column="2" MinWidth="118"
                                Command="{Binding NextProductPageCommand}"
                                Content="Próxima"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
