                                                    <Run Text=" • " />
                                                    <Run Text="{Binding DetailRegister.StatusText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" MinWidth="128"
                                                    Command="{Binding LoadRegisterDetailCommand}"
