                                                       FontWeight="{DynamicResource FontWeightBody}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="Preço · R$ 12,90" />
                                            <Button Margin="0,16,0,0"
                                                    HorizontalAlignment="Left"
                                                    AutomationProperties.Name="Botão de exemplo da pré-visualização"
                                                    Content="Botão de exemplo"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,18,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Tema claro/escuro e acessibilidade são independentes. Alto contraste funciona nos dois temas."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
