                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding RecipientDraft, UpdateSourceTrigger=PropertyChanged}" ToolTip="email@exemplo.com" Style="{StaticResource TextInputStyle}">
                                                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddRecipientCommand}"/></TextBox.InputBindings>
                                                                </TextBox>
                                                                <Button Grid.Column="2" Width="48" Command="{Binding AddRecipientCommand}" Content="+" Style="{StaticResource PrimaryButtonStyle}" />
                                                            </Grid>
                                                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Recipients}">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="14" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock VerticalAlignment="Center" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding}" />
                                                                                <Button Margin="8,0,0,0" Padding="3,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" Content="×"
                                                                                        Command="{Binding DataContext.RemoveRecipientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding ValidationMessage}" />
                                                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" Text="Adicione um e-mail por vez. Use o botão + ou Enter." />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button HorizontalAlignment="Left" MinWidth="160" Command="{Binding SaveEmailAlertSettingsCommand}" Content="Salvar alertas" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource SettingsInnerPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Como funciona" />
                                        <TextBlock Margin="0,18,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Sem repetição" />
                                        <TextBlock Margin="0,5,0,14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="O mesmo alerta só é enviado uma vez enquanto a situação não mudar." TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Estoque" />
                                        <TextBlock Margin="0,5,0,14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Envia quando esgota ou fica abaixo do mínimo." TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Contas" />
                                        <TextBlock Margin="0,5,0,14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Envia no vencimento e quando estiver vencida." TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Assinatura" />
                                        <TextBlock Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Envia quando faltarem até 3 dias para vencer." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </TabItem>

