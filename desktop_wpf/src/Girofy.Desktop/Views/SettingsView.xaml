<UserControl x:Class="Girofy.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCardTitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsSectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsSmallLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="SettingsPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource AccessibilityBorderThickness}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="SettingsInnerPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource AccessibilityBorderThickness}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style TargetType="TabControl" x:Key="SettingsTabControlStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <!--
                O TabPanel padrão move a linha selecionada para perto do conteúdo.
                Uma única grade uniforme preserva posição, ordem e largura em
                todas as trocas de aba.
            -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="10" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Padding="5"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{DynamicResource AccessibilityBorderThickness}"
                                    CornerRadius="10">
                                <ItemsPresenter x:Name="HeaderPanel"
                                                KeyboardNavigation.DirectionalNavigation="Contained"
                                                KeyboardNavigation.TabIndex="1" />
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem" x:Key="SettingsTabItemStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="Padding" Value="17,11" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="24,20"
                    Style="{StaticResource HeroCardStyle}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource FontSizeHero}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Configurações" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="{DynamicResource FontSizeInput}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Gerencie os dados do usuário conectado e as preferências da adega." />
                </StackPanel>
                <ToggleButton Grid.Column="1"
                              Command="{Binding ToggleThemeCommand}"
                              IsChecked="{Binding IsDarkMode, Mode=OneWay}"
                              AutomationProperties.Name="Alternar tema"
                              Style="{StaticResource ThemeToggleButtonStyle}" />
                <Button Grid.Column="3"
                        MinWidth="112"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <Border Padding="12"
                        Margin="0,0,0,8"
                        Background="{DynamicResource ErrorSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Padding="12"
                        Background="{DynamicResource SuccessSurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <UniformGrid Grid.Row="4" Columns="3" Visibility="Collapsed">
                <Border Margin="0,0,10,0"
                        Style="{StaticResource SettingsInnerPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                   Text="USUÁRIO" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="{DynamicResource FontSizeCardTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding UsernameText}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding EmailText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Margin="5,0"
                        Style="{StaticResource SettingsInnerPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                   Text="ADEGA" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="{DynamicResource FontSizeCardTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding CompanyName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding RoleText}" />
                    </StackPanel>
                </Border>

                <Border Margin="10,0,0,0"
                        Style="{StaticResource SettingsInnerPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                   Text="ASSINATURA" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="{DynamicResource FontSizeCardTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Text="{Binding PlanText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SubscriptionText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="6"
                    Style="{StaticResource SettingsPanelStyle}">
                <TabControl Style="{StaticResource SettingsTabControlStyle}"
                            ItemContainerStyle="{StaticResource SettingsTabItemStyle}">
                    <TabItem Header="Usuário">
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SettingsInnerPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                                   Text="Dados do perfil" />
                                        <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                                   Text="Atualize as informações usadas no atendimento e no registro das ações." />
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Nome" />
                                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Sobrenome" />
                                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Telefone" />
                                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                                       Text="RESUMO" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding NegativeStockText}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding FeeText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                MinWidth="142"
                                                Command="{Binding SaveProfileCommand}"
                                                Content="Salvar perfil"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SettingsInnerPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                                   Text="Segurança" />
                                        <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                                   Text="Troque a senha do usuário conectado sem sair do aplicativo." />
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Senha atual" />
                                            <PasswordBox x:Name="CurrentPasswordInput"
                                                         PasswordChanged="HandleCurrentPasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Nova senha" />
                                            <PasswordBox x:Name="NewPasswordInput"
                                                         PasswordChanged="HandleNewPasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Confirmar senha" />
                                            <PasswordBox x:Name="ConfirmPasswordInput"
                                                         PasswordChanged="HandleConfirmPasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Ao alterar a senha, confira se digitou a confirmação corretamente."
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="2"
                                                MinWidth="166"
                                                Command="{Binding ChangePasswordCommand}"
                                                Content="Alterar senha"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Grid.Column="4"
                                                MinWidth="178"
                                                Command="{Binding OpenWebSettingsCommand}"
                                                Content="Abrir versão web"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Equipe" Visibility="{Binding TeamVisibility}">
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="18" Style="{StaticResource SettingsInnerPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}" Text="TOTAL DA EQUIPE" />
                                        <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding TeamMemberCount}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="acessos cadastrados" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="18" Style="{StaticResource SettingsInnerPanelStyle}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}" Text="ATIVOS" />
                                        <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}" Text="{Binding ActiveTeamMemberCount}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="podem acessar o sistema" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Padding="18" Style="{StaticResource SettingsInnerPanelStyle}"
                                        BorderBrush="{DynamicResource WarningBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}" Text="INATIVOS" />
                                        <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}" Text="{Binding InactiveTeamMemberCount}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="acessos suspensos" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource SettingsInnerPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                                       Text="Adicionar funcionário" />
                                            <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                                       Text="Crie um acesso individual e defina o nível de permissão na equipe." />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                MinWidth="132"
                                                Command="{Binding RefreshTeamCommand}"
                                                Content="Atualizar equipe"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Usuário" />
                                            <TextBox Text="{Binding NewEmployeeUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Nome usado para entrar no Girofy"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Senha" />
                                            <PasswordBox x:Name="NewEmployeePasswordInput"
                                                         ToolTip="Senha inicial do funcionário"
                                                         PasswordChanged="HandleNewEmployeePasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Nome" />
                                            <TextBox Text="{Binding NewEmployeeFirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Perfil" />
                                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding NewEmployeeRole, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Sobrenome" />
                                            <TextBox Text="{Binding NewEmployeeLastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource SettingsLabelStyle}" Text="CPF" />
                                            <TextBox Text="{Binding NewEmployeeCpf, UpdateSourceTrigger=PropertyChanged}" ToolTip="Somente números" Style="{StaticResource TextInputStyle}" /></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource SettingsLabelStyle}" Text="E-mail" />
                                            <TextBox Text="{Binding NewEmployeeEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" /></StackPanel>
                                        <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Telefone" />
                                            <TextBox Text="{Binding NewEmployeePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" /></StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Cada funcionário deve usar seu próprio acesso para manter a auditoria correta." TextWrapping="Wrap" />
                                        <Button Grid.Column="1" MinWidth="112" Command="{Binding ClearNewEmployeeCommand}"
                                                Content="Limpar" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="3" MinWidth="166" Command="{Binding CreateEmployeeCommand}"
                                                Content="Adicionar à equipe" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.85*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsInnerPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Funcionários" />
                                            <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}" Text="Pesquise e selecione um acesso para editar." />
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding TeamSearch, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}"
                                                     ToolTip="Nome, usuário ou e-mail" />
                                            <Button Grid.Column="2"
                                                    MinWidth="92"
                                                    Command="{Binding RefreshTeamCommand}"
                                                    Content="Buscar"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <DataGrid Grid.Row="4"
                                                  MinHeight="220"
                                                  ItemsSource="{Binding Employees}"
                                                  SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  RowHeight="52"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Funcionário" Binding="{Binding DisplayName}" Width="*" />
                                                <DataGridTextColumn Header="Usuário" Binding="{Binding Username}" Width="120" />
                                                <DataGridTextColumn Header="Perfil" Binding="{Binding RoleLabel}" Width="100" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="78" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="Nenhum funcionário encontrado.">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding HasTeamMembers}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsInnerPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
