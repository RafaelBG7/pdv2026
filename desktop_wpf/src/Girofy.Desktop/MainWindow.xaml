<Window x:Class="Girofy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Girofy.Desktop.Views"
        Title="Girofy"
        Icon="Resources/logo-girofy.png"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Login.IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid Margin="28">
                <Border MaxWidth="860"
                        Padding="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource HeroGradientBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="62" Height="62" Background="#FFFFFF" CornerRadius="8">
                                <Image Margin="5" Source="Resources/logo-girofy.png" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Girofy" />
                                <TextBlock Margin="0,3,0,0" FontSize="15"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Aplicativo Windows" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Padding="16" BorderThickness="1" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="{StaticResource InfoSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="14" Height="14" HorizontalAlignment="Left"
                                         VerticalAlignment="Top" Margin="0,4,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource InfoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding StatusTitle}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding StatusDescription}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <StackPanel Width="340" MaxWidth="340" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Entrar" />
                                <TextBlock Margin="0,6,0,22" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Use o mesmo acesso da sua conta Girofy." TextWrapping="Wrap" />
                                <TextBlock Margin="0,0,0,7" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Usuário ou e-mail" />
                                <TextBox x:Name="IdentifierInput"
                                         Text="{Binding Login.Identifier, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                                <TextBlock Margin="0,18,0,7" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Senha" />
                                <Grid>
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="HandlePasswordChanged">
                                        <PasswordBox.Style>
                                            <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordInputStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Login.ShowPassword}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </PasswordBox.Style>
                                    </PasswordBox>
                                    <TextBox x:Name="VisiblePasswordInput"
                                             Text="{Binding Login.Password, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource TextInputStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Login.ShowPassword}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Foreground="{StaticResource TextSecondaryBrush}"
                                              IsChecked="{Binding Login.RememberUsername}"
                                              Content="Lembrar usuário" />
                                    <CheckBox Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}"
                                              IsChecked="{Binding Login.ShowPassword}"
                                              Checked="HandlePasswordVisibilityChanged"
                                              Unchecked="HandlePasswordVisibilityChanged"
                                              Content="Mostrar senha" />
                                </Grid>
                                <Border Margin="0,16,0,0" Padding="12"
                                        Background="{StaticResource ErrorSurfaceBrush}"
                                        BorderBrush="{StaticResource ErrorBorderBrush}"
                                        BorderThickness="1" CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Login.HasError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding Login.ErrorMessage}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,16,0,0" Padding="14"
                                        Background="{StaticResource InfoSurfaceBrush}"
                                        BorderBrush="{StaticResource InfoBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Login.RequiresSubscriptionActivation}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="Ativar assinatura" />
                                        <TextBlock Margin="0,4,0,12"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="Informe a key gerada no painel master para liberar esta adega."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Text="Key de ativação" />
                                        <TextBox Text="{Binding Login.ActivationKey, UpdateSourceTrigger=PropertyChanged}"
                                                 CharacterCasing="Upper"
                                                 Style="{StaticResource TextInputStyle}" />
                                        <Button Margin="0,12,0,0" Height="46"
                                                Command="{Binding Login.ActivateSubscriptionCommand}"
                                                Content="{Binding Login.ActivationButtonText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,20,0,0" Height="50" IsDefault="True"
                                        Command="{Binding Login.LoginCommand}"
                                        Content="{Binding Login.LoginButtonText}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Login.ShowLoginButton}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Margin="0,12,0,0" HorizontalAlignment="Center"
                                        Command="{Binding Login.ForgotPasswordCommand}"
                                        Content="Esqueci minha senha"
                                        Style="{StaticResource LinkButtonStyle}" />
                            </StackPanel>

                            <StackPanel Width="340" MaxWidth="340" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Servidor indisponível" TextAlignment="Center" />
                                <TextBlock Margin="0,8,0,20" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Verifique sua internet e tente conectar novamente."
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Command="{Binding RetryConnectionCommand}"
                                        Content="Tentar novamente"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Text="SERVIDOR" />
                                <TextBlock Margin="0,3,0,0" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding ServerAddress}" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="150"
                                    Command="{Binding OpenWebCommand}" Content="Abrir versão web"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Margin="22">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Login.IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,10" Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" Background="#FFFFFF" CornerRadius="6">
                            <Image Margin="4" Source="Resources/logo-girofy.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Text="Girofy" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Aplicativo Windows nativo" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Login.AuthenticatedUserName}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding Login.AuthenticatedCompanyName}" />
                        </StackPanel>
                        <Button MinWidth="92" Command="{Binding Login.LogoutCommand}"
                                Content="Sair" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" Background="{StaticResource SidebarGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="8" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Text="MENU" />
                        <Button Grid.Row="2" Margin="0,0,0,8" Command="{Binding ShowDashboardCommand}"
                                Content="▦  Dashboard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="3" Margin="0,0,0,8" Command="{Binding ShowProductsCommand}"
                                Content="◇  Produtos">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                                <Condition Binding="{Binding Catalog.IsProductsView}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="4" Command="{Binding ShowCategoriesCommand}"
                                Content="□  Categorias">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                                <Condition Binding="{Binding Catalog.IsCategoriesView}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="5" Margin="0,8,0,0"
                                IsEnabled="{Binding Sales.IsAvailable}"
                                Command="{Binding ShowSalesCommand}"
                                Content="$  Vendas">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSalesView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="6" Margin="0,8,0,0"
                                IsEnabled="{Binding CashRegister.IsAvailable}"
                                Command="{Binding ShowCashRegisterCommand}"
                                Content="◉  Caixa">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashRegisterView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="7" Margin="0,8,0,0"
                                IsEnabled="{Binding Stock.CanViewStock}"
                                Command="{Binding ShowStockCommand}"
                                Content="▣  Estoque">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStockView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="8" Margin="0,8,0,0"
                                IsEnabled="{Binding Payables.IsAvailable}"
                                Command="{Binding ShowPayablesCommand}"
                                Content="▤  Contas">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPayablesView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="9" Margin="0,8,0,0"
                                IsEnabled="{Binding Reports.IsAvailable}"
                                Command="{Binding ShowReportsCommand}"
                                Content="▥  Relatórios">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReportsView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="10" Margin="0,8,0,0"
                                IsEnabled="{Binding Audit.IsAvailable}"
                                Command="{Binding ShowAuditCommand}"
                                Content="◇  Auditoria">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuditView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="11" Margin="0,8,0,0"
                                Command="{Binding ShowSettingsCommand}"
                                Content="○  Ajustes">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Grid.Row="13" Margin="8">
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Text="SERVIDOR" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding ServerAddress}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="24" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:DashboardView DataContext="{Binding Dashboard}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCashRegisterView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:CashRegisterView DataContext="{Binding CashRegister}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalesView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:SalesView DataContext="{Binding Sales}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStockView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:StockView DataContext="{Binding Stock}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReportsView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:ReportsView DataContext="{Binding Reports}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuditView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:AuditView DataContext="{Binding Audit}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:SettingsView DataContext="{Binding Settings}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPayablesView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:PayablesView DataContext="{Binding Payables}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                            <Condition Binding="{Binding Catalog.IsProductsView}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="27" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Produtos" />
                                <TextBlock Margin="0,4,0,0" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Cadastre, edite e acompanhe o estoque dos produtos." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button MinWidth="132" Margin="0,0,10,0"
                                        Command="{Binding Catalog.OpenNewProductCommand}"
                                        Content="Novo produto" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Command="{Binding Catalog.RefreshCommand}"
                                        Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Padding="18" CornerRadius="10"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Buscar" />
                                <TextBlock Grid.Column="2" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Status" />
                                <TextBlock Grid.Column="4" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Ordenar" />

                                <TextBox Grid.Row="2"
                                         Text="{Binding Catalog.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Buscar produto"
                                         Style="{StaticResource TextInputStyle}" />
                                <ComboBox Grid.Row="2" Grid.Column="2"
                                          ItemsSource="{Binding Catalog.ActiveFilters}"
                                          SelectedItem="{Binding Catalog.SelectedActiveFilter}"
                                          DisplayMemberPath="Label" />
                                <ComboBox Grid.Row="2" Grid.Column="4"
                                          ItemsSource="{Binding Catalog.SortOptions}"
                                          SelectedItem="{Binding Catalog.SelectedSort}"
                                          DisplayMemberPath="Label" />
                                <Button Grid.Row="2" Grid.Column="6" MinWidth="108"
                                        Command="{Binding Catalog.SearchCommand}"
                                        Content="Pesquisar" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Row="2" Grid.Column="8" MinWidth="120"
                                        Command="{Binding Catalog.OpenEditProductCommand}"
                                        Content="Editar item" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Padding="12" Background="{StaticResource ErrorSurfaceBrush}"
                                BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Catalog.HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Catalog.ErrorMessage}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="16" CornerRadius="10"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="CATEGORIAS" />
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding Catalog.Categories}"
                                             SelectedItem="{Binding Catalog.SelectedCategory, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="CategoryItemBorder"
                                                                    Padding="14,10"
                                                                    Background="{StaticResource SurfaceBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CategoryItemBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                                    <Setter TargetName="CategoryItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="CategoryItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                    <Setter TargetName="CategoryItemBorder" Property="Background" Value="#30245C" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" MinWidth="34" Height="26" Padding="8,0"
                                                            Background="{StaticResource SurfaceElevatedBrush}"
                                                            CornerRadius="13">
                                                        <TextBlock VerticalAlignment="Center" TextAlignment="Center"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding ProductCount}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Column="2" ItemsSource="{Binding Catalog.Products}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      CanUserDeleteRows="False" CanUserReorderColumns="False"
                                      CanUserResizeRows="False" SelectionMode="Single"
                                      SelectedItem="{Binding Catalog.SelectedProduct, Mode=TwoWay}"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      Background="{StaticResource SurfaceRaisedBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="Transparent"
                                      RowBackground="{StaticResource SurfaceRaisedBrush}"
                                      AlternatingRowBackground="#102034"
                                      RowHeight="66" ColumnHeaderHeight="48">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2.1*" />
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="1.25*" />
                                    <DataGridTextColumn Header="Venda" Binding="{Binding SalePriceText}" Width="0.8*" />
                                    <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.75*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.7*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding Catalog.ProductSummary}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Catalog.PageSummary}" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="132"
                                    Command="{Binding Catalog.OpenEditProductCommand}"
                                    Content="Editar selecionado" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="3" MinWidth="92"
                                    IsEnabled="{Binding Catalog.CanGoPrevious}"
                                    Command="{Binding Catalog.PreviousPageCommand}"
                                    Content="Anterior" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="5" MinWidth="92"
                                    IsEnabled="{Binding Catalog.CanGoNext}"
                                    Command="{Binding Catalog.NextPageCommand}"
                                    Content="Próxima" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Grid Grid.RowSpan="9" Panel.ZIndex="20" Background="#B8050B16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Catalog.IsProductEditorOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border MaxWidth="900" Margin="24" Padding="24" CornerRadius="14"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    Background="{StaticResource HeroGradientBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="24" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding Catalog.EditorTitle}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Preencha os dados principais do produto." />
                                        </StackPanel>
                                        <Button Grid.Column="1" MinWidth="100"
                                                Command="{Binding Catalog.CloseProductEditorCommand}"
                                                Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="0.65*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Nome" />
                                            <TextBox Text="{Binding Catalog.EditorName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Código" />
                                            <TextBox Text="{Binding Catalog.EditorBarcode, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Categoria" />
                                            <ComboBox ItemsSource="{Binding Catalog.Categories}"
                                                      SelectedItem="{Binding Catalog.EditorCategory}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Ativo" />
                                            <CheckBox Margin="4,14,0,0"
                                                      IsChecked="{Binding Catalog.EditorActive}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Custo" />
                                            <TextBox Text="{Binding Catalog.EditorCostPrice, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Venda" />
                                            <TextBox Text="{Binding Catalog.EditorSalePrice, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="4">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Estoque" />
                                            <TextBox Text="{Binding Catalog.EditorStockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="6">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Mínimo" />
                                            <TextBox Text="{Binding Catalog.EditorMinStockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="4">
                                        <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Text="Motivo do estoque" />
                                        <TextBox Text="{Binding Catalog.EditorStockReason, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Motivo do ajuste de estoque"
                                                 Style="{StaticResource TextInputStyle}" />
                                    </StackPanel>

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Os valores usam o mesmo cadastro da versão web." />
                                        <Button Grid.Column="1" MinWidth="110"
                                                Command="{Binding Catalog.CloseProductEditorCommand}"
                                                Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="3" MinWidth="130"
                                                Command="{Binding Catalog.SaveProductCommand}"
                                                Content="Salvar produto" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                            <Condition Binding="{Binding Catalog.IsCategoriesView}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="27" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Categorias" />
                                <TextBlock Margin="0,4,0,0" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Organização atual dos produtos da adega." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button MinWidth="132" Command="{Binding Catalog.OpenNewCategoryCommand}"
                                        Content="Nova categoria" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="126"
                                        Command="{Binding Catalog.OpenEditCategoryCommand}"
                                        Content="Editar" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="126"
                                        Command="{Binding Catalog.DeleteCategoryCommand}"
                                        Content="Excluir" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="112" Command="{Binding Catalog.RefreshCommand}"
                                        Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" Padding="16" CornerRadius="8"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Catalog.IsCategoryEditorOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding Catalog.CategoryEditorTitle}" />
                                    <TextBox Text="{Binding Catalog.CategoryEditorName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="100" VerticalAlignment="Bottom"
                                        Command="{Binding Catalog.CloseCategoryEditorCommand}"
                                        Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="4" MinWidth="120" VerticalAlignment="Bottom"
                                        Command="{Binding Catalog.SaveCategoryCommand}"
                                        Content="Salvar" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding Catalog.CategoryRows}"
                                  SelectedItem="{Binding Catalog.SelectedCategoryRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column" EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Background="{StaticResource SurfaceRaisedBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  VerticalGridLinesBrush="Transparent"
                                  RowBackground="{StaticResource SurfaceRaisedBrush}"
                                  AlternatingRowBackground="#102034"
                                  RowHeight="50" ColumnHeaderHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Produtos" Binding="{Binding ProductCount}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
