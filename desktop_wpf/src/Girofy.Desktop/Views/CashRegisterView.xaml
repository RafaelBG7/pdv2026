<UserControl x:Class="Girofy.Desktop.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="CashTimelineSaleTemplate">
            <Expander Margin="0,0,0,9"
                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Expanded="TimelineSaleExpander_Expanded">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding HeaderText}" />
                        <TextBlock Grid.Column="1" Margin="18,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding PaymentsText}" />
                        <TextBlock Grid.Column="2" Margin="18,0,0,0" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding FinalAmountText}" />
                    </Grid>
                </Expander.Header>
                <Border Margin="16,10,16,12" Padding="14"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Margin="0,12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Carregando detalhes da venda...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="128"
                                    Command="{Binding RetryCommand}" Content="Tentar novamente"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding SaleNumberText}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding DateTimeText}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SellerText, StringFormat=Operador: {0}}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="10,5" CornerRadius="10"
                                        Background="{DynamicResource InfoSurfaceBrush}"
                                        BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}">
                                    <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"
                                               Text="{Binding StatusText}" />
                                </Border>
                            </Grid>

                            <Border Margin="0,0,0,12" Padding="12"
                                    Background="{DynamicResource ErrorSurfaceBrush}"
                                    BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Text="VENDA CANCELADA" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding CancelledByText, StringFormat=Cancelada por: {0}}" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding CancelledAtText, StringFormat=Data: {0}}" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Text="{Binding CancellationReasonText, StringFormat=Motivo: {0}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,0,0,7" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="ITENS DA VENDA" />
                            <Border MaxHeight="220" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" MinWidth="82" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding UnitPriceText}" />
                                                    <TextBlock Grid.Column="2" MinWidth="58" Margin="10,0" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding QuantityText}" />
                                                    <TextBlock Grid.Column="3" MinWidth="88" HorizontalAlignment="Right" FontWeight="{DynamicResource FontWeightStrong}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="RESUMO DA VENDA" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Subtotal dos produtos" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Desconto" />
                                    <TextBlock Margin="0,6,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Total da venda" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" MinWidth="110">
                                    <TextBlock Text=" " />
                                    <TextBlock Margin="0,7,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DiscountAmountText}" />
                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding FinalAmountText}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,0,0,7" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="PAGAMENTO" />
                            <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding AmountText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Valor recebido" />
                                <TextBlock Grid.Column="1" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PaidAmountText}" />
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Troco" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ChangeAmountText}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasProfit}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Lucro da venda" />
                                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding ProfitAmountText}" />
                            </Grid>

                            <Border Padding="12" Background="{DynamicResource InfoSurfaceBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Text="SALDO ANTES DA VENDA" />
                                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding BalanceBeforeSaleText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Text="SALDO APÓS A VENDA" />
                                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding BalanceAfterSaleText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly"
                  ScrollViewer.IsDeferredScrollingEnabled="False">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Caixa" />
                    <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Abra, acompanhe e feche o caixa da sua adega." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Margin="0,0,0,18" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button MinWidth="132" Height="42"
                                Command="{Binding ShowCurrentRegisterTabCommand}"
                                Content="Caixa atual">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentRegisterTabSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button MinWidth="158" Height="42" Margin="8,0,0,0"
                                Command="{Binding ShowPreviousRegistersTabCommand}"
                                Content="Caixas anteriores">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviousRegistersTabSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Padding="12" Margin="0,0,0,8"
                        Background="{DynamicResource ErrorSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Padding="12"
                        Background="{DynamicResource SuccessSurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Padding="22"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasNoOpenRegister}" Value="True" />
                                    <Condition Binding="{Binding IsCurrentRegisterTabSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Caixa fechado" />
                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Informe o valor disponível para iniciar as vendas do turno."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Valor inicial" />
                            <TextBox Text="{Binding OpeningAmountText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Valor inicial em reais"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" MinWidth="156" Margin="0,20,0,0"
                                Command="{Binding OpenCommand}"
                                AutomationProperties.Name="Abrir caixa"
                                Content="Abrir caixa"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="Transparent" BorderThickness="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasOpenRegister}" Value="True" />
                                    <Condition Binding="{Binding IsCurrentRegisterTabSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.NumberText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Resumo do caixa atual em operação" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,6"
                                Background="{DynamicResource SuccessSurfaceBrush}"
                                BorderBrush="{DynamicResource SuccessBorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                            <TextBlock FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Text="Aberto" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="20" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Resumo do caixa" />
                                <TextBlock Margin="0,4,0,16" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding CurrentRegister.OpenedAtText}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Responsável" />
                                    <TextBlock Grid.Column="1" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding CurrentRegister.ResponsibleUser}" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Vendas realizadas" />
                                    <TextBlock Grid.Column="1" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding CurrentRegister.SalesCountText}" />
                                </Grid>
                                <Border Height="1" Margin="0,4,0,14" Background="{DynamicResource BorderBrush}" />
                                <UniformGrid Columns="3">
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextMutedBrush}" Text="SALDO INICIAL" />
                                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding CurrentRegister.OpeningAmountText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextMutedBrush}" Text="TOTAL VENDIDO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"
                                                   Text="{Binding CurrentRegister.SalesTotalText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextMutedBrush}" Text="SALDO ESPERADO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                                   Text="{Binding CurrentRegister.ExpectedAmountText}" />
                                    </StackPanel>
                                </UniformGrid>
                                <Border Margin="0,20,0,0" Padding="14" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Valor contado" />
                                            <TextBox Margin="0,7,0,0" Text="{Binding ClosingAmountText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Valor contado no caixa em reais" Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" MinWidth="138" Margin="0,19,0,0" Command="{Binding CloseCommand}"
                                                AutomationProperties.Name="Fechar caixa"
                                                Content="Fechar caixa" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="20" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Meios de pagamento" />
                                <TextBlock Margin="0,4,0,14" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Totais recebidos neste caixa" />
                                <ItemsControl ItemsSource="{Binding CurrentRegister.PaymentTotals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,0" MinHeight="44">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" VerticalAlignment="Center" Background="{DynamicResource InfoSurfaceBrush}"
                                                        BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="12">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeTiny}"
                                                               Foreground="{DynamicResource InfoBrush}" Text="●" />
                                                </Border>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Label}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding AmountText}" />
                                                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Saldo final esperado" />
                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                               Text="{Binding CurrentRegister.ExpectedAmountText}" />
