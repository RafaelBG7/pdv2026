<UserControl x:Class="Girofy.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Girofy.Desktop.Controls">
    <UserControl.Resources>
        <controls:ChartPaletteBrushConverter x:Key="ChartPaletteBrushConverter"/>
        <controls:DashboardRankConverter x:Key="DashboardRankConverter"/>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Text="VISÃO GERAL"/><TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Dashboard"/><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.PeriodRangeText, FallbackValue=Visão consolidada da operação}"/></StackPanel>
                <ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
                <DatePicker Grid.Column="3" Width="125" SelectedDate="{Binding CustomStartDate}" ToolTip="Data inicial"><DatePicker.Style><Style TargetType="DatePicker"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomPeriod}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DatePicker.Style></DatePicker>
                <DatePicker Grid.Column="5" Width="125" SelectedDate="{Binding CustomEndDate}" ToolTip="Data final"><DatePicker.Style><Style TargetType="DatePicker"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomPeriod}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DatePicker.Style></DatePicker>
                <Button Grid.Column="7" MinWidth="90" Command="{Binding ApplyPeriodCommand}" Content="Aplicar" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Grid.Column="9" MinWidth="160" Command="{Binding DataContext.StartSaleCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Realizar venda — F3" Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>

            <Border Margin="0,0,0,16" Padding="13" Background="{DynamicResource ErrorSurfaceBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="7"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/></Border>
            <Border MinHeight="170" Padding="24" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasData}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="220" Height="4" IsIndeterminate="{Binding IsBusy}"/><TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EmptyMessage}"/></StackPanel>
            </Border>

            <StackPanel>
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasData}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Margin="0,0,7,0" Padding="18" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="FATURAMENTO"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Snapshot.Summary.SalesTotalText}"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.Summary.SalesTotalChangeText}"/></StackPanel></Border>
                    <Border Margin="7,0" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="VENDAS"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Snapshot.Summary.SalesCountText}"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.Summary.SalesCountDetailText}"/></StackPanel></Border>
                    <Border Margin="7,0" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="CLIENTES"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="—"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Módulo ainda não ativado"/></StackPanel></Border>
                    <Border Margin="7,0,0,0" Padding="18" Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.Permissions.CanViewReports}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="LUCRO ESTIMADO"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Snapshot.Summary.ProfitText}"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.Summary.ProfitChangeText}"/></StackPanel></Border>
                </UniformGrid>

                <Grid Margin="0,0,0,16"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.Permissions.CanViewReports}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Text="DESEMPENHO"/><TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Faturamento no período"/></StackPanel><TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Snapshot.Summary.SalesTotalText}"/></Grid>
                            <Grid Grid.Row="1" Height="270" Margin="0,12,0,0">
                                <controls:RevenueLineChart Points="{Binding Snapshot.RevenueSeries.Points}">
                                    <controls:RevenueLineChart.Style><Style TargetType="controls:RevenueLineChart"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasRevenueData}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:RevenueLineChart.Style>
                                </controls:RevenueLineChart>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasRevenueData}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Nenhuma venda neste período"/>
                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="As vendas concluídas aparecerão aqui."/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Text="DISTRIBUIÇÃO"/><TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Vendas por categoria"/></StackPanel>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasCategorySales}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <controls:CategoryDonutChart Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Items="{Binding Snapshot.CategorySales}"/>
                                <ItemsControl Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" AlternationCount="7" ItemsSource="{Binding Snapshot.CategorySales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="9" Height="9" CornerRadius="5" Background="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource ChartPaletteBrushConverter}}"/>
                                                <TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Category}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SummaryText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasCategorySales}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Sem categorias vendidas"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="A distribuição será calculada após a primeira venda."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Text="RANKING"/><TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Produtos mais vendidos"/><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Snapshot.TopProducts}" AlternationCount="99"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Border Width="28" Height="28" HorizontalAlignment="Left" Background="{DynamicResource SelectionSoftBrush}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A78BFA" Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource DashboardRankConverter}}"/></Border><StackPanel Grid.Column="1"><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding Category, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding QuantityText, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding TotalText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Margin="0,28" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Nenhum produto vendido"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasTopProducts}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Text="ATIVIDADE"/><TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Vendas recentes"/><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Snapshot.RecentSales}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding NumberText}"/><StackPanel Grid.Column="1"><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding UserName}"/><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PaymentText}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding FinalAmountText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Margin="0,28" HorizontalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasRecentSales}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Nenhuma venda no período"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="As vendas concluídas aparecerão aqui."/></StackPanel></StackPanel></Border>
                </Grid>

                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Text="OPERAÇÃO"/><TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Estoque baixo"/><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Snapshot.LowStockProducts}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Text="!"/></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Name}"/><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding MinimumText}"/></StackPanel><TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StockText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Margin="0,28" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Estoque em dia"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasLowStockProducts}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.Permissions.CanManagePayables}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Text="FINANCEIRO"/><TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Contas próximas"/><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Snapshot.UpcomingPayables}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="R$"/><StackPanel Grid.Column="1"><TextBlock FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Description}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DueDateText}"/></StackPanel><TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding AmountText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Margin="0,28" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Nenhuma conta crítica"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.HasUpcomingPayables}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
