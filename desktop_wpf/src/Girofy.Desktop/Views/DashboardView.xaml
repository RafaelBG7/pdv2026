<UserControl x:Class="Girofy.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Dashboard" />
                    <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Snapshot.ReferenceDateText, FallbackValue=Visão da operação da sua adega.}" />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="170"
                        Command="{Binding DataContext.StartSaleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="Realizar venda — F3"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="3" MinWidth="104"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border Grid.Row="2" Padding="13"
                    Background="{DynamicResource ErrorSurfaceBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border MinHeight="170" Padding="24"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="{Binding IsBusy}" />
                        <TextBlock Margin="0,16,0,0" FontSize="{DynamicResource FontSizeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding EmptyMessage}" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="4">
                    <Border Margin="0,0,8,0" Padding="17"
                            Background="{DynamicResource InfoSurfaceBrush}"
                            BorderBrush="{DynamicResource InfoBorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="VENDIDO HOJE" />
                            <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Snapshot.Summary.SalesTotalText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Snapshot.Summary.SalesCountText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0" Padding="17"
                            Background="{DynamicResource SuccessSurfaceBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="CAIXA ATUAL" />
                            <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Snapshot.CashRegister.StatusText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Snapshot.CashRegister.DescriptionText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding Snapshot.CashRegister.SalesSummaryText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0" Padding="17"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="TICKET MÉDIO" />
                            <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Snapshot.Summary.AverageTicketText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Snapshot.Summary.ProfitSummaryText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Padding="17"
                            Background="{DynamicResource ErrorSurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="ESTOQUE BAIXO" />
                            <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Snapshot.Summary.LowStockText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Itens para revisar" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Snapshot.Permissions.CanViewReports}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Formas de pagamento de hoje" />
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Snapshot.PaymentTotals}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,0" Padding="12"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Label}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="{DynamicResource FontWeightStrong}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding AmountText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="16" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="230" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Vendas recentes" />
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Snapshot.RecentSales}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="36"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      VerticalGridLinesBrush="Transparent"
                                      RowBackground="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource AlternatingRowBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Venda" Binding="{Binding NumberText}" Width="72" />
                                    <DataGridTextColumn Header="Data" Binding="{Binding DateText}" Width="1.2*" />
                                    <DataGridTextColumn Header="Vendedor" Binding="{Binding UserName}" Width="1*" />
                                    <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentText}" Width="1.1*" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding FinalAmountText}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="16"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="230" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Estoque baixo" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding Snapshot.LowStockProducts}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding MinimumText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" FontWeight="Bold"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       Text="{Binding StockText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="6" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Produtos mais vendidos hoje" />
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Snapshot.TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding QuantityText}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding TotalText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
