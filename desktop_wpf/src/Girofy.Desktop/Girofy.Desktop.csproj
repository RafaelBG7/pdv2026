<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SkyGest</AssemblyName>
    <RootNamespace>Girofy.Desktop</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Product>SkyGest</Product>
    <Title>SkyGest</Title>
    <Description>SkyGest — o seu gestor inteligente</Description>
    <ApplicationIcon>Resources\SkyGest.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Girofy.Application\Girofy.Application.csproj" />
    <ProjectReference Include="..\Girofy.Infrastructure\Girofy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\skygest-app-icon.png" />
    <Resource Include="Resources\skygest-logo-horizontal.png" />
    <Resource Include="Resources\SkyGest.ico" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.Homologation.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
