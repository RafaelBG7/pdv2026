<UserControl x:Class="Girofy.Desktop.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Girofy.Desktop.Behaviors"
             xmlns:models="clr-namespace:Girofy.Application.Models;assembly=Girofy.Application">
    <UserControl.Resources>
        <Style x:Key="AuditMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>
        <Style x:Key="AuditPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  ScrollViewer.IsDeferredScrollingEnabled="False">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="Auto" /><RowDefinition Height="18" />
                <RowDefinition Height="Auto" /><RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource HeroCardStyle}" Padding="26,24" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeHero}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Auditoria" />
                        <TextBlock Margin="0,7,0,0" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Consulte ações críticas registradas na adega." />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="112" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                            Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="12" Background="{DynamicResource ErrorSurfaceBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <UniformGrid Grid.Row="4" Columns="3">
                <Border Margin="0,0,10,0" Style="{StaticResource AuditMetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="12,0,0,12" />
                        <StackPanel Grid.Column="1" Margin="22,18" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSizeLabel}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Eventos" />
                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Summary.Count}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="5,0" Style="{StaticResource AuditMetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource InfoBrush}" CornerRadius="12,0,0,12" />
                        <StackPanel Grid.Column="1" Margin="22,18" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSizeLabel}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Usuários envolvidos" />
                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Summary.Users}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="10,0,0,0" Style="{StaticResource AuditMetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="12,0,0,12" />
                        <StackPanel Grid.Column="1" Margin="22,18" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSizeLabel}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Ações diferentes" />
                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Summary.Actions}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="18"
                    behaviors:EnterCommandBehavior.Command="{Binding SearchCommand}"
                    BorderBrush="{DynamicResource InfoBorderBrush}" Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="48" />
                        <RowDefinition Height="15" /><RowDefinition Height="Auto" /><RowDefinition Height="7" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Busca" />
                    <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Usuário" />
                    <TextBlock Grid.Column="4" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Ação" />
                    <TextBlock Grid.Column="6" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Módulo" />
                    <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Buscar auditoria" Style="{StaticResource TextInputStyle}" />
                    <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Label" />
                    <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" DisplayMemberPath="Label" />
                    <ComboBox Grid.Row="2" Grid.Column="6" ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}" DisplayMemberPath="Label" />

                    <TextBlock Grid.Row="4" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Método" />
                    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Data inicial" />
                    <TextBlock Grid.Row="4" Grid.Column="4" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="Data final" />
                    <ComboBox Grid.Row="6" ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Label" />
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="DD/MM/AAAA" MaxLength="10"
                             behaviors:BrazilianDateInputBehavior.IsEnabled="True" Style="{StaticResource TextInputStyle}" />
                    <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="DD/MM/AAAA" MaxLength="10"
                             behaviors:BrazilianDateInputBehavior.IsEnabled="True" Style="{StaticResource TextInputStyle}" />
                    <Grid Grid.Row="6" Grid.Column="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{Binding SearchCommand}" Content="Filtrar" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="2" Command="{Binding ClearFiltersCommand}" Content="Limpar" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="8" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="12" Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" MaxHeight="590"
                              Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="Transparent" RowBackground="{DynamicResource SurfaceRaisedBrush}"
                              AlternatingRowBackground="{DynamicResource AlternatingRowBrush}" RowHeight="72" ColumnHeaderHeight="52">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="DATA E HORA" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="{DynamicResource FontSizeLabel}" FontWeight="Bold" Text="{Binding CreatedDateText}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding CreatedTimeText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="USUÁRIO" Binding="{Binding UserNameText}" Width="150" />
                            <DataGridTemplateColumn Header="AÇÃO" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AuditPillStyle}" Background="{DynamicResource WarningSurfaceBrush}"
                                                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}">
                                            <TextBlock MaxWidth="175" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}"
                                                       Foreground="{DynamicResource WarningBrush}" Text="{Binding ActionText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="MÓDULO" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AuditPillStyle}" Background="{DynamicResource InfoSurfaceBrush}"
                                                BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}">
                                            <TextBlock MaxWidth="120" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}"
                                                       Foreground="{DynamicResource AccentBrush}" Text="{Binding EntityText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Description}" Width="*" MinWidth="260" />
                            <DataGridTextColumn Header="ID" Binding="{Binding EntityIdText}" Width="80" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate DataType="{x:Type models:AuditLogRecord}">
                                <Border Margin="12,0,12,12" Padding="16" CornerRadius="9"
                                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Text="ANTES" />
                                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding OldValuesText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Text="DEPOIS" />
                                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding NewValuesText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <UniformGrid Grid.Row="2" Grid.ColumnSpan="3" Columns="4">
                                            <StackPanel Margin="0,0,10,0"><TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Text="ROTA" /><TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding RouteText}" /></StackPanel>
                                            <StackPanel Margin="0,0,10,0"><TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Text="MÉTODO" /><TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding MethodText}" /></StackPanel>
                                            <StackPanel Margin="0,0,10,0"><TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Text="REQUEST ID" /><TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding RequestText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <StackPanel><TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Text="IP" /><TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding IpText}" /></StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Nenhum evento de auditoria encontrado." />
                    </Border>

                    <Grid Grid.Row="1" Margin="18,14,18,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PageSummary}" />
                        <Button Grid.Column="1" MinWidth="96" IsEnabled="{Binding CanGoPrevious}" Command="{Binding PreviousPageCommand}" Content="Anterior" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="3" MinWidth="96" IsEnabled="{Binding CanGoNext}" Command="{Binding NextPageCommand}" Content="Próxima" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
