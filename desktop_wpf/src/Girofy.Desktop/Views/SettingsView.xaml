<UserControl x:Class="Girofy.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsSectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsSmallLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="SettingsPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SettingsInnerPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style TargetType="TabControl" x:Key="SettingsTabControlStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem" x:Key="SettingsTabItemStyle">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource InfoSurfaceBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Configurações" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Organize perfil, equipe, operação, financeiro e ferramentas da adega." />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="112"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Padding="12"
                        Margin="0,0,0,8"
                        Background="{StaticResource ErrorSurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Padding="12"
                        Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <UniformGrid Grid.Row="4" Columns="3">
                <Border Margin="0,0,10,0"
                        Style="{StaticResource SettingsInnerPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                   Text="USUÁRIO" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding UsernameText}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding EmailText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Margin="5,0"
                        Style="{StaticResource SettingsInnerPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                   Text="ADEGA" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding CompanyName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding RoleText}" />
                    </StackPanel>
                </Border>

                <Border Margin="10,0,0,0"
                        Style="{StaticResource SettingsInnerPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                   Text="ASSINATURA" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"
                                   Text="{Binding PlanText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding SubscriptionText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="6"
                    Style="{StaticResource SettingsPanelStyle}">
                <TabControl Style="{StaticResource SettingsTabControlStyle}"
                            ItemContainerStyle="{StaticResource SettingsTabItemStyle}">
                    <TabItem Header="Usuário">
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SettingsInnerPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                                   Text="Dados do perfil" />
                                        <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                                   Text="Atualize as informações usadas no atendimento e no registro das ações." />
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Nome" />
                                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Sobrenome" />
                                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Telefone" />
                                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                                       Text="RESUMO" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding NegativeStockText}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding FeeText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                MinWidth="142"
                                                Command="{Binding SaveProfileCommand}"
                                                Content="Salvar perfil"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SettingsInnerPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                                   Text="Segurança" />
                                        <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                                   Text="Troque a senha do usuário conectado sem sair do aplicativo." />
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Senha atual" />
                                            <PasswordBox x:Name="CurrentPasswordInput"
                                                         PasswordChanged="HandleCurrentPasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Nova senha" />
                                            <PasswordBox x:Name="NewPasswordInput"
                                                         PasswordChanged="HandleNewPasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Confirmar senha" />
                                            <PasswordBox x:Name="ConfirmPasswordInput"
                                                         PasswordChanged="HandleConfirmPasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="Ao alterar a senha, confira se digitou a confirmação corretamente."
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="2"
                                                MinWidth="166"
                                                Command="{Binding ChangePasswordCommand}"
                                                Content="Alterar senha"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Grid.Column="4"
                                                MinWidth="178"
                                                Command="{Binding OpenWebSettingsCommand}"
                                                Content="Abrir versão web"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Equipe" Visibility="{Binding TeamVisibility}">
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SettingsInnerPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                                       Text="Novo funcionário" />
                                            <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                                       Text="Cadastre um acesso operacional, gerente ou administrador para a adega." />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                MinWidth="132"
                                                Command="{Binding RefreshTeamCommand}"
                                                Content="Atualizar equipe"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Usuário" />
                                            <TextBox Text="{Binding NewEmployeeUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Senha" />
                                            <PasswordBox x:Name="NewEmployeePasswordInput"
                                                         PasswordChanged="HandleNewEmployeePasswordChanged"
                                                         Style="{StaticResource PasswordInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Nome" />
                                            <TextBox Text="{Binding NewEmployeeFirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Perfil" />
                                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding NewEmployeeRole, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewEmployeeLastName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}"
                                                 ToolTip="Sobrenome" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding NewEmployeeCpf, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}"
                                                 ToolTip="CPF" />
                                        <TextBox Grid.Column="4"
                                                 Text="{Binding NewEmployeeEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}"
                                                 ToolTip="E-mail" />
                                        <Button Grid.Column="6"
                                                MinWidth="112"
                                                Command="{Binding ClearNewEmployeeCommand}"
                                                Content="Limpar"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="8"
                                                MinWidth="136"
                                                Command="{Binding CreateEmployeeCommand}"
                                                Content="Cadastrar"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.45*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsInnerPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="Buscar funcionário" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding TeamSearch, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}"
                                                     ToolTip="Buscar funcionário" />
                                            <Button Grid.Column="2"
                                                    MinWidth="92"
                                                    Command="{Binding RefreshTeamCommand}"
                                                    Content="Buscar"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <DataGrid Grid.Row="4"
                                                  MinHeight="220"
                                                  ItemsSource="{Binding Employees}"
                                                  SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Funcionário" Binding="{Binding DisplayName}" Width="*" />
                                                <DataGridTextColumn Header="Perfil" Binding="{Binding RoleLabel}" Width="112" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="82" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsInnerPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="Editar funcionário selecionado" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Nome" />
                                                <TextBox Text="{Binding EmployeeFirstName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource TextInputStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Sobrenome" />
                                                <TextBox Text="{Binding EmployeeLastName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource TextInputStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="CPF" />
                                                <TextBox Text="{Binding EmployeeCpf, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource TextInputStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding EmployeeEmail, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}"
                                                     ToolTip="E-mail" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding EmployeePhone, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}"
                                                     ToolTip="Telefone" />
                                            <ComboBox Grid.Column="4"
                                                      ItemsSource="{Binding RoleOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding EmployeeRole, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Grid.Column="6"
                                                      VerticalAlignment="Center"
                                                      Content="Ativo"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      IsChecked="{Binding EmployeeIsActive}" />
                                            <Button Grid.Column="8"
                                                    MinWidth="122"
                                                    Command="{Binding SaveEmployeeCommand}"
                                                    Content="Salvar"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Operação" Visibility="{Binding CompanySettingsVisibility}">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Regras de operação" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="Controle como a adega registra vendas quando o estoque estiver zerado ou negativo." />
                                </StackPanel>

                                <UniformGrid Grid.Row="2" Columns="2">
                                    <Border Margin="0,0,8,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                                       Text="ESTOQUE" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding NegativeStockText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="8,0,0,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                                       Text="USO" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InfoBrush}"
                                                       Text="Venda e baixa de estoque" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              IsChecked="{Binding AllowNegativeStock, UpdateSourceTrigger=PropertyChanged}"
                                              Content="Permitir vender produto sem estoque e manter estoque negativo" />
                                    <Button Grid.Column="2"
                                            MinWidth="148"
                                            Command="{Binding SaveCompanySettingsCommand}"
                                            Content="Salvar operação"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Financeiro" Visibility="{Binding CompanySettingsVisibility}">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Taxas e lucro" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="Ative as taxas de pagamento para descontar Pix, débito ou crédito no lucro final." />
                                </StackPanel>

                                <UniformGrid Grid.Row="2" Columns="3">
                                    <Border Margin="0,0,8,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <CheckBox Margin="0,0,0,10"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      IsChecked="{Binding PixFeeEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Taxa Pix" />
                                            <TextBox Text="{Binding PixFeePercent, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="4,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <CheckBox Margin="0,0,0,10"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      IsChecked="{Binding DebitFeeEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Taxa débito" />
                                            <TextBox Text="{Binding DebitFeePercent, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="8,0,0,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <CheckBox Margin="0,0,0,10"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      IsChecked="{Binding CreditFeeEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Taxa crédito" />
                                            <TextBox Text="{Binding CreditFeePercent, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding FeeText}"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="2"
                                            MinWidth="148"
                                            Command="{Binding SaveCompanySettingsCommand}"
                                            Content="Salvar taxas"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Alertas">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Alertas da adega" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="A versão Windows mostra os alertas operacionais. A configuração detalhada de envio por e-mail continua disponível na versão web." />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="168"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenWebSettingsCommand}"
                                        Content="Configurar na web"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Backup" Visibility="{Binding BackupVisibility}">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Backup" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="Configure a frequência de segurança e gere uma cópia manual quando necessário." />
                                </StackPanel>

                                <UniformGrid Grid.Row="2" Columns="3">
                                    <Border Margin="0,0,8,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                                       Text="FREQUÊNCIA" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding BackupFrequencyText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="4,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                                       Text="ÚLTIMO BACKUP" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding BackupLastAtText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="8,0,0,0"
                                            Style="{StaticResource SettingsInnerPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsSmallLabelStyle}"
                                                       Text="STATUS" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InfoBrush}"
                                                       Text="{Binding BackupStatusText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsLabelStyle}"
                                                   Text="Frequência automática" />
                                        <ComboBox ItemsSource="{Binding BackupFrequencyOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding BackupFrequency, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            MinWidth="150"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding SaveBackupSettingsCommand}"
                                            Content="Salvar frequência"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="4"
                                            MinWidth="168"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding RunManualBackupCommand}"
                                            Content="Gerar backup agora"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Importação" Visibility="{Binding ImportVisibility}">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Importação" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="Envie uma planilha CSV ou XLSX para criar ou atualizar produtos da adega atual. Colunas aceitas: produto, categoria, custo, venda, estoque e estoque mínimo." />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="176"
                                        VerticalAlignment="Center"
                                        Command="{Binding ImportProductsCommand}"
                                        Content="Importar planilha"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Exportação" Visibility="{Binding ExportVisibility}">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Exportação" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="Gere uma planilha CSV com dados da adega atual para conferência ou análise externa." />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsLabelStyle}"
                                                   Text="Tipo de exportação" />
                                        <ComboBox ItemsSource="{Binding ExportTypeOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedExportType, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            MinWidth="164"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding ExportDataCommand}"
                                            Content="Exportar CSV"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Suporte">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Suporte" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="Atualize os dados locais ou abra a versão web para manutenção completa." />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="112"
                                        VerticalAlignment="Center"
                                        Command="{Binding RefreshCommand}"
                                        Content="Atualizar"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="4"
                                        MinWidth="168"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenWebSettingsCommand}"
                                        Content="Abrir versão web"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Acessibilidade">
                        <Border Margin="0,18,0,0"
                                Style="{StaticResource SettingsInnerPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                               Text="Acessibilidade visual" />
                                    <TextBlock Style="{StaticResource SettingsSectionDescriptionStyle}"
                                               Text="As preferências detalhadas de tamanho, contraste e negrito ainda ficam na versão web. O aplicativo Windows vai herdar esse painel em uma próxima etapa." />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="176"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenWebSettingsCommand}"
                                        Content="Ajustar na web"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
