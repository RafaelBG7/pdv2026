                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviousRegistersTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Histórico de caixas" />
                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Selecione uma linha para consultar resumo, pagamentos e movimentações." />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="112" Command="{Binding RefreshCommand}"
                            Content="Atualizar lista" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <DataGrid ItemsSource="{Binding RecentRegisters}"
                          x:Name="RecentRegistersGrid"
                          MaxHeight="620"
                          SelectedItem="{Binding SelectedRegister, Mode=TwoWay}"
                          PreviewMouseLeftButtonDown="RecentRegistersGrid_PreviewMouseLeftButtonDown"
                          SelectionChanged="RecentRegistersGrid_SelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeRows="False" SelectionMode="Single"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="{DynamicResource SurfaceRaisedBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          VerticalGridLinesBrush="Transparent"
                          RowBackground="{DynamicResource SurfaceRaisedBrush}"
                                      AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                          RowHeight="54" ColumnHeaderHeight="40">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentRegisters}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Clique para abrir; clique novamente para recolher" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,1,0,1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Ação" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource InfoSurfaceBrush}" CornerRadius="5">
                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource InfoBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Abrir" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Text" Value="Recolher" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Caixa" Binding="{Binding NumberText}" Width="0.8*" />
                        <DataGridTextColumn Header="Abertura" Binding="{Binding OpenedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Fechamento" Binding="{Binding ClosedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Responsável" Binding="{Binding ResponsibleUser}" Width="1.1*" />
                        <DataGridTextColumn Header="Vendas" Binding="{Binding SalesCountText}" Width="0.85*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding SalesTotalText}" Width="0.9*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.75*" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Margin="10,0,10,14" Padding="18"
