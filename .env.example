# Segurança
SECRET_KEY=troque-esta-chave-em-producao
APP_ENV=development
FLASK_DEBUG=0
MASTER_DEFAULT_USERNAME=master
MASTER_DEFAULT_PASSWORD=troque-esta-senha
PASSWORD_MIN_LENGTH=8
SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=8388608

# MySQL central
MYSQL_USER=adega_app
MYSQL_PASSWORD=troque-esta-senha-do-banco
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=adega_central

# Opcional: URL completa do banco central.
# Se DATABASE_URL for definida, ela sobrescreve MYSQL_USER/MYSQL_PASSWORD/MYSQL_HOST/MYSQL_PORT/MYSQL_DATABASE.
# DATABASE_URL=mysql+pymysql://adega_app:senha@127.0.0.1:3306/adega_central?charset=utf8mb4

# Bancos separados por adega
MYSQL_TENANT_DATABASE_PREFIX=adega
MYSQL_TENANT_DATABASE_URL_TEMPLATE=
MYSQL_SERVER_DATABASE_URL=mysql+pymysql://adega_admin:senha@127.0.0.1:3306/mysql?charset=utf8mb4

PUBLIC_BASE_URL=http://127.0.0.1:5001

# Envio de e-mails pelo Gmail
MAIL_SMTP_SERVER=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_LOGIN=girofy2026@gmail.com
MAIL_SMTP_PASSWORD=cole-a-senha-de-app-do-gmail
MAIL_FROM_EMAIL=girofy2026@gmail.com
MAIL_FROM_NAME=Girofy
MAIL_SUPPRESS_SEND=0

# Servidor Flask local
PORT=5001

# Produção Docker/OCI
# Usado pelo docker-compose.oci.yml. Gere senhas fortes antes de publicar.
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-do-mysql
GIROFY_SITE_ADDRESS=:18080
GIROFY_PUBLIC_HTTP_PORT=18080

# Backup automático completo do MySQL (banco central e todas as adegas)
AUTO_BACKUP_ENABLED=1
AUTO_BACKUP_INTERVAL_SECONDS=86400
AUTO_BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_RETENTION_COUNT=30
GIROFY_BACKUP_HOST_DIR=/opt/girofy/backups
GIROFY_BACKUP_UID=1001
GIROFY_BACKUP_GID=1001

# Limpeza automática de auditoria
# A cada 3 dias, remove registros de auditoria mais antigos que 90 dias.
AUTO_AUDIT_CLEANUP_ENABLED=1
AUTO_AUDIT_CLEANUP_INTERVAL_SECONDS=259200
AUTO_AUDIT_RETENTION_DAYS=90

# OCI CLI - Free Tier
# Preencha no .env local ou crie .env.oci a partir de .env.oci.example.
OCI_AUTH_MODE=security_token
OCI_CLI_PROFILE=GIROFY
OCI_CONFIG_FILE=/Users/rafaelborges/.oci/config
OCI_SESSION_EXPIRATION_MINUTES=60
OCI_CLI_TENANCY=ocid1.tenancy.oc1..aaaa
OCI_CLI_USER=
OCI_CLI_FINGERPRINT=
OCI_CLI_KEY_FILE=/Users/rafaelborges/.oci/oci_api_key.pem
OCI_CLI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_ID=
OCI_AVAILABILITY_DOMAIN=
OCI_SSH_PUBLIC_KEY_FILE=/Users/rafaelborges/.ssh/id_ed25519.pub
OCI_ALLOWED_SSH_CIDR=SEU_IP_PUBLICO/32
OCI_ALLOWED_HTTP_CIDR=0.0.0.0/0
OCI_PUBLIC_HTTP_PORT=18080
OCI_PROJECT_PREFIX=girofy
OCI_INSTANCE_NAME=girofy-app-01
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=1
OCI_MEMORY_GB=6
OCI_BOOT_VOLUME_GB=50
OCI_VCN_CIDR=10.10.0.0/16
OCI_SUBNET_CIDR=10.10.1.0/24
OCI_IMAGE_OS=Canonical Ubuntu
OCI_IMAGE_OS_VERSION=22.04
