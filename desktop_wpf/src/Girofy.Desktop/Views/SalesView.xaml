                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Subtotal" />
                                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Total com desconto" />
                                <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Text="{Binding DraftTotalAfterDiscountText}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Valor do desconto" />
                        <TextBox x:Name="DiscountPopupInput"
                                 Text="{Binding DraftDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="DiscountPopupInput_PreviewKeyDown"
                                 Style="{StaticResource TextInputStyle}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Percentual aplicado: " />
                            <Run FontWeight="Bold" Text="{Binding DraftDiscountPercentText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Height="46"
                                Command="{Binding CloseDiscountPopupCommand}"
                                Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Height="46"
                                Command="{Binding ApplyDiscountCommand}"
                                Content="Aplicar desconto"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Mantém falhas de validação/API acima do modal que originou a ação. -->
        <Border Panel.ZIndex="200" Margin="28,22,28,0" Padding="14,12"
                MaxWidth="920" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource ErrorSurfaceBrush}"
                BorderBrush="{DynamicResource ErrorBorderBrush}"
                BorderThickness="{DynamicResource AccessibilityBorderThickness}"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15"
                        Background="{DynamicResource ErrorBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="White" Text="!" />
                </Border>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
