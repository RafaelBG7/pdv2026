<UserControl x:Class="Girofy.Desktop.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Caixa" />
                    <TextBlock Margin="0,4,0,0" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Abra, acompanhe e feche o caixa da sua adega." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Padding="12" Margin="0,0,0,8"
                        Background="{StaticResource ErrorSurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Padding="12"
                        Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Padding="22"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoOpenRegister}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Caixa fechado" />
                        <TextBlock Margin="0,5,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Informe o valor disponível para iniciar as vendas do turno."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Valor inicial" />
                            <TextBox Text="{Binding OpeningAmountText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Valor inicial em reais"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" MinWidth="156" Margin="0,20,0,0"
                                Command="{Binding OpenCommand}"
                                Content="Abrir caixa"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="22"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOpenRegister}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="21" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.NumberText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Caixa atual em operação" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,6"
                                Background="{StaticResource SuccessSurfaceBrush}"
                                BorderBrush="{StaticResource SuccessBorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="Aberto" />
                        </Border>
                    </Grid>

                    <UniformGrid Margin="0,18,0,0" Columns="3">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="ABERTO EM" />
                            <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.OpenedAtText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="RESPONSÁVEL" />
                            <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.ResponsibleUser}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="MOVIMENTO" />
                            <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.SalesCountText}" />
                        </StackPanel>
                    </UniformGrid>

                    <Border Margin="0,20,0,0" Padding="16"
                            Background="{StaticResource InfoSurfaceBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="VALOR INICIAL" />
                                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding CurrentRegister.OpeningAmountText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="TOTAL VENDIDO" />
                                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource InfoBrush}"
                                               Text="{Binding CurrentRegister.SalesTotalText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="VALOR ESPERADO" />
                                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding CurrentRegister.ExpectedAmountText}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Margin="0,18,0,8" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="TOTAL POR FORMA DE PAGAMENTO" />
                            <ItemsControl ItemsSource="{Binding CurrentRegister.PaymentTotals}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,8" Padding="12,8"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding Label}" />
                                                <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding AmountText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Fechar caixa" />
                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Conte o valor disponível e informe o total exato."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Valor contado" />
                                    <TextBox Text="{Binding ClosingAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Valor contado no caixa em reais"
                                             Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="156" Margin="0,20,0,0"
                                        Command="{Binding CloseCommand}"
                                        Content="Fechar caixa"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="6">
                <TextBlock FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Caixas recentes" />
                <TextBlock Margin="0,4,0,12" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Últimos caixas registrados nesta adega." />
                <DataGrid ItemsSource="{Binding RecentRegisters}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeRows="False" SelectionMode="Single"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="Transparent"
                          RowBackground="{StaticResource SurfaceRaisedBrush}"
                          AlternatingRowBackground="#102034"
                          RowHeight="50" ColumnHeaderHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Caixa" Binding="{Binding NumberText}" Width="0.8*" />
                        <DataGridTextColumn Header="Abertura" Binding="{Binding OpenedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Fechamento" Binding="{Binding ClosedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Responsável" Binding="{Binding ResponsibleUser}" Width="1.1*" />
                        <DataGridTextColumn Header="Vendas" Binding="{Binding SalesCountText}" Width="0.85*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding SalesTotalText}" Width="0.9*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.75*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
