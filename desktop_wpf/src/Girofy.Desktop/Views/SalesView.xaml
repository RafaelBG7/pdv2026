<UserControl x:Class="Girofy.Desktop.Views.SalesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="SalesView_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SaleHistoryRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Vendas" />
                        <TextBlock Margin="0,4,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Abra uma nova venda em janela separada e finalize o pagamento em outra etapa." />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="170" Height="46"
                            Command="{Binding OpenSaleEditorCommand}"
                            Content="Nova venda - F3" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <Border Grid.Row="2" Padding="12" Background="{StaticResource ErrorSurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="4" Padding="12" Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="6" Padding="28" Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Venda rápida" />
                            <TextBlock Margin="0,6,0,0" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Clique em Nova venda para abrir o pedido em uma janela dedicada." />
                            <TextBlock Margin="0,10,0,0" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding CartSummary}" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="180" Height="50"
                                VerticalAlignment="Center"
                                Command="{Binding OpenSaleEditorCommand}"
                                Content="Iniciar venda - F3" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>

                        <Border Margin="0,22,0,0" Padding="18" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Vendas do dia/caixa" />
                                    <TextBlock Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Histórico registrado" />
                                </Grid>

                                <StackPanel Grid.Row="2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTodaySales}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Padding="12,10" Background="{StaticResource SurfaceRaisedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.75*" />
                                                <ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="0.75*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Venda" />
                                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Data" />
                                            <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Vendedor" />
                                            <TextBlock Grid.Column="3" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Total" />
                                            <TextBlock Grid.Column="4" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Pagamento" />
                                            <TextBlock Grid.Column="5" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Ação" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TodaySales}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1,0,1,1"
                                                        Background="{StaticResource SurfaceBrush}">
                                                    <StackPanel>
                                                        <Button Style="{StaticResource SaleHistoryRowButtonStyle}"
                                                                Command="{Binding DataContext.ToggleTodaySaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Border Padding="12">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource InfoSurfaceBrush}" />
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="0.75*" />
                                                                        <ColumnDefinition Width="1.35*" />
                                                                        <ColumnDefinition Width="1*" />
                                                                        <ColumnDefinition Width="0.95*" />
                                                                        <ColumnDefinition Width="1.2*" />
                                                                        <ColumnDefinition Width="0.75*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="13" FontWeight="Bold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               Text="{Binding NumberText}" />
                                                                    <TextBlock Grid.Column="1" FontSize="13"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               Text="{Binding DateText}" />
                                                                    <TextBlock Grid.Column="2" FontSize="13"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               Text="{Binding UserName}" />
                                                                    <TextBlock Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               Text="{Binding FinalAmountText}" />
                                                                    <TextBlock Grid.Column="4" FontSize="13"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               Text="{Binding PaymentText}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource InfoBrush}"
                                                                               Text="{Binding ExpandHint}" />
                                                                </Grid>
                                                            </Border>
                                                        </Button>

                                                        <Border Margin="12,0,12,12" Padding="16"
                                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                                BorderBrush="{StaticResource InfoBorderBrush}"
                                                                BorderThickness="1" CornerRadius="8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Text="Carregando detalhes...">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoadingDetail}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Foreground="{StaticResource ErrorBrush}"
                                                                           Text="{Binding DetailError}"
                                                                           TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDetailError}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Grid>
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="16" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <StackPanel>
                                                                        <TextBlock FontSize="16" FontWeight="Bold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   Text="Produtos" />
                                                                        <Border Margin="0,10,0,0" Padding="12"
                                                                                Background="{StaticResource SurfaceBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="70" />
                                                                                        <ColumnDefinition Width="110" />
                                                                                        <ColumnDefinition Width="110" />
                                                                                        <ColumnDefinition Width="110" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Produto" />
                                                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Qtd." />
                                                                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Unitário" />
                                                                                    <TextBlock Grid.Column="3" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Subtotal" />
                                                                                    <TextBlock Grid.Column="4" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Lucro final" />
                                                                                </Grid>
                                                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Detail.Items}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Padding="0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                        <ColumnDefinition Width="70" />
                                                                                                        <ColumnDefinition Width="110" />
                                                                                                        <ColumnDefinition Width="110" />
                                                                                                        <ColumnDefinition Width="110" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                                                                                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding QuantityText}" />
                                                                                                    <TextBlock Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding UnitPriceText}" />
                                                                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                                                                                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="{Binding ProfitAmountText}" />
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Row="2">
                                                                        <TextBlock FontSize="16" FontWeight="Bold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   Text="Pagamento" />
                                                                        <Border Margin="0,10,0,0" Padding="12"
                                                                                Background="{StaticResource SurfaceBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6">
                                                                            <StackPanel>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Subtotal" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Detail.SubtotalText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Desconto" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Detail.DiscountAmountText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Total" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Text="{Binding Detail.FinalAmountText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Pago" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Detail.PaidAmountText}" />
                                                                                </Grid>
                                                                                <Grid Margin="0,0,0,12">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Troco" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Text="{Binding Detail.ChangeAmountText}" />
                                                                                </Grid>
                                                                                <Separator Background="{StaticResource BorderBrush}" />
                                                                                <Grid Margin="0,12,0,0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="Formas" />
                                                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DetailPaymentsText}" />
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Padding="0,18"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Nenhuma venda registrada hoje.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoTodaySales}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Padding="28" Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Text="Venda concluída" />
                        <TextBlock Margin="0,5,0,22" HorizontalAlignment="Center" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Receipt.SaleNumberText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TOTAL" />
                                <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" Text="{Binding Receipt.FinalAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="PAGO" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Receipt.PaidAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TROCO" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoBrush}" Text="{Binding Receipt.ChangeAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="CAIXA" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Receipt.CashRegisterText}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,22,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ReceiptPaymentsText}" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Receipt.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding QuantityText}" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource InfoSurfaceBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Receipt.HasStockWarnings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding ReceiptStockWarningsText}" TextWrapping="Wrap" />
                        </Border>
                        <Button Margin="0,22,0,0" Height="52" Command="{Binding NewSaleCommand}"
                                Content="Nova venda - F3" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Panel.ZIndex="55" Background="#CC000914">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpenCashPromptOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Margin="24" Padding="24" MaxWidth="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Caixa fechado" />
                        <TextBlock Margin="0,4,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Para registrar uma venda, abra o caixa agora. Pressione Enter para confirmar."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="2" Padding="16" Background="{StaticResource InfoSurfaceBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                   Text="Deseja abrir o caixa e continuar para a nova venda?" />
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Valor inicial em caixa" />
                        <TextBox x:Name="OpeningCashInput"
                                 Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}"
