                                        <UniformGrid Margin="0,16,0,0" Columns="4">
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Text="ABERTURA" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.OpenedAtText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Text="FECHAMENTO" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.ClosedAtText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Text="VENDAS" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.SalesCountText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Text="TOTAL VENDIDO" />
                                                <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                                           Foreground="{DynamicResource InfoBrush}"
                                                           Text="{Binding DetailRegister.SalesTotalText}" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <Border Margin="0,0,0,14" Padding="12"
                                    Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailRegister.HasCancellationAdjustment}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                            <TextBlock FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"
                                                           Text="Ajuste posterior ao fechamento" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding DetailRegister.CancellationAdjustmentText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="A conferência original foi preservada." />
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,4,0,0" Padding="14"
                                                Background="{DynamicResource InfoSurfaceBrush}"
                                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="VALOR INICIAL" />
                                                        <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding DetailRegister.OpeningAmountText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="VALOR FINAL" />
                                                        <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding DetailRegister.ClosingAmountText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="VALOR ESPERADO" />
                                                        <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding DetailRegister.ExpectedAmountText}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Margin="0,4,0,8" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="Formas de pagamento" />
                                                <ItemsControl ItemsSource="{Binding DetailRegister.PaymentTotals}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="38">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource InfoBrush}" Text="●" />
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Text="{Binding Label}" />
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding AmountText}" />
                                                                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Margin="0,18,0,10" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Linha do tempo de vendas" />
                                        <TextBlock Margin="0,0,0,8" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Nenhuma venda vinculada a este caixa.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoTimeline}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox MaxHeight="360"
                                                 ItemsSource="{Binding Timeline}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{StaticResource CashTimelineSaleTemplate}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <Border Margin="0,14,0,0" Padding="22"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoRecentRegisters}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="{DynamicResource FontWeightStrong}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Nenhum caixa anterior encontrado" />
                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Os caixas encerrados aparecerão aqui." />
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Clique em qualquer caixa para abrir vendas, itens e pagamentos." />
                    <Button Grid.Column="1" MinWidth="150"
                            Command="{Binding LoadRegisterDetailCommand}"
                            Content="Atualizar detalhe"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <Border Margin="0,14,0,0" Padding="12" Visibility="Collapsed"
                        Background="{DynamicResource InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource InfoBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Carregando detalhes do caixa..." />
                </Border>

                <Border Margin="0,16,0,0" Padding="18" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource InfoBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.NumberText}" />
                                <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding DetailRegister.StatusText}" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="118"
                                    Command="{Binding ClearRegisterDetailCommand}"
                                    Content="Fechar"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <UniformGrid Margin="0,16,0,0" Columns="4">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="ABERTURA" />
                                <TextBlock Margin="0,5,0,0" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.OpenedAtText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="FECHAMENTO" />
                                <TextBlock Margin="0,5,0,0" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.ClosedAtText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="RESPONSÁVEL" />
                                <TextBlock Margin="0,5,0,0" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.ResponsibleUser}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="VENDAS" />
                                <TextBlock Margin="0,5,0,0" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.SalesCountText}" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Margin="0,16,0,0" Padding="14"
                                Background="{DynamicResource InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="VALOR INICIAL" />
                                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding DetailRegister.OpeningAmountText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="TOTAL VENDIDO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                                   Foreground="{DynamicResource InfoBrush}"
                                                   Text="{Binding DetailRegister.SalesTotalText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="FECHAMENTO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding DetailRegister.ClosingAmountText}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Margin="0,14,0,8" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Pagamentos do caixa" />
                                <ItemsControl ItemsSource="{Binding DetailRegister.PaymentTotals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,10,8" Padding="12,8"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding AmountText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,10" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Linha do tempo de vendas" />
                        <TextBlock Margin="0,0,0,8" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Nenhuma venda vinculada a este caixa.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoTimeline}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Timeline}"
                                      ItemTemplate="{StaticResource CashTimelineSaleTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
