<UserControl x:Class="Girofy.Desktop.Views.NotificationsPopoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" MaxHeight="460">
    <Border Padding="20" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Opacity="0.42" ShadowDepth="8" Color="#020617" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="1" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Alertas" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding UnreadCount, Mode=OneWay}" /><Run Text=" pendentes" />
                    </TextBlock>
                    <Button Padding="9,5" Command="{Binding MarkAllReadCommand}" Content="Marcar lidas"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="4">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="Carregando alertas...">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock MaxWidth="420" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Margin="0,10,0,0" Command="{Binding RefreshCommand}" Content="Tentar novamente" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSubtitle}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="Nenhuma alteração necessária agora.">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasNoItems}" Value="True"/><Condition Binding="{Binding HasError}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>

                <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource InfoBrush}" CornerRadius="4" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontSize="{DynamicResource FontSizeLabel}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" />
                                            <TextBlock Margin="0,4,0,0" MaxWidth="365" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Message}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}">
                                                <Run Text="{Binding CategoryText, Mode=OneWay}" /><Run Text=" • " /><Run Text="{Binding CreatedAtText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                            <Button Padding="7,4" Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Content="Lida" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Margin="0,5,0,0" Padding="7,4" Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Content="Dispensar" Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
