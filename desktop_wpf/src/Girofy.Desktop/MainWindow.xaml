                                                <Button Width="30" Height="30" Margin="0,4,4,4"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Command="{Binding Catalog.ClearKitComponentCommand}"
                                                        Content="×" ToolTip="Limpar produto-base">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Catalog.EditorKitComponentSearchText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
