                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding EmailAlertCompanyName}" />
                                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding EmailAlertSmtpText}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding EmailAlertSettings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,14" Style="{StaticResource SettingsInnerPanelStyle}">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
