                    </Grid>

                    <Border Grid.Row="4" Padding="18"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="10">
