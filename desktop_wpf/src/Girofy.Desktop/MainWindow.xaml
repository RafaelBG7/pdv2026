<Window x:Class="Girofy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Girofy.Desktop.Views"
        Title="Girofy"
        Icon="Resources/logo-girofy.png"
        Width="470"
        Height="700"
        MinWidth="470"
        MinHeight="640"
        MaxWidth="470"
        MaxHeight="700"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Login.IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid Margin="12">
                <Border MaxWidth="860"
                        Padding="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource HeroGradientBrush}"
                        BorderBrush="{DynamicResource InfoBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="62" Height="62" Background="{DynamicResource LogoTileBrush}" CornerRadius="8">
                                <Image Margin="5" Source="Resources/logo-girofy.png" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="32" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="Girofy" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Command="{Binding Settings.ToggleThemeCommand}"
                                          IsChecked="{Binding Settings.IsDarkMode, Mode=OneWay}"
                                          AutomationProperties.Name="Alternar tema"
                                          Style="{StaticResource ThemeToggleButtonStyle}" />
                        </Grid>

                        <Border Grid.Row="2" Padding="16" BorderThickness="1" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="14" Height="14" HorizontalAlignment="Left"
                                         VerticalAlignment="Top" Margin="0,4,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource InfoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding StatusTitle}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding StatusDescription}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <StackPanel Width="340" MaxWidth="340" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="Entrar" />
                                <TextBlock Margin="0,6,0,22" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Use o mesmo acesso da sua conta Girofy." TextWrapping="Wrap" />
                                <TextBlock Margin="0,0,0,7" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="Usuário ou e-mail" />
                                <TextBox x:Name="IdentifierInput"
                                         Text="{Binding Login.Identifier, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                                <TextBlock Margin="0,18,0,7" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="Senha" />
                                <Grid>
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="HandlePasswordChanged">
                                        <PasswordBox.Style>
                                            <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordInputStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Login.ShowPassword}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </PasswordBox.Style>
                                    </PasswordBox>
                                    <TextBox x:Name="VisiblePasswordInput"
                                             Text="{Binding Login.Password, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource TextInputStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Login.ShowPassword}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Foreground="{DynamicResource TextSecondaryBrush}"
                                              IsChecked="{Binding Login.RememberUsername}"
                                              Content="Lembrar usuário" />
                                    <CheckBox Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"
                                              IsChecked="{Binding Login.ShowPassword}"
                                              Checked="HandlePasswordVisibilityChanged"
                                              Unchecked="HandlePasswordVisibilityChanged"
                                              Content="Mostrar senha" />
                                </Grid>
                                <Border Margin="0,16,0,0" Padding="12"
                                        Background="{DynamicResource ErrorSurfaceBrush}"
                                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                                        BorderThickness="1" CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Login.HasError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Login.ErrorMessage}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,16,0,0" Padding="14"
                                        Background="{DynamicResource InfoSurfaceBrush}"
                                        BorderBrush="{DynamicResource InfoBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Login.RequiresSubscriptionActivation}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Ativar assinatura" />
                                        <TextBlock Margin="0,4,0,12"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Informe a key gerada no painel master para liberar esta adega."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="Key de ativação" />
                                        <TextBox Text="{Binding Login.ActivationKey, UpdateSourceTrigger=PropertyChanged}"
                                                 CharacterCasing="Upper"
                                                 Style="{StaticResource TextInputStyle}" />
                                        <Button Margin="0,12,0,0" Height="46"
                                                Command="{Binding Login.ActivateSubscriptionCommand}"
                                                Content="{Binding Login.ActivationButtonText}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,20,0,0" Height="50" IsDefault="True"
                                        Command="{Binding Login.LoginCommand}"
                                        Content="{Binding Login.LoginButtonText}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Login.ShowLoginButton}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Command="{Binding Login.ForgotPasswordCommand}"
                                            Content="Esqueci minha senha"
                                            Style="{StaticResource LinkButtonStyle}" />
                                    <TextBlock Margin="8,0" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Text="•" />
                                    <Button Command="{Binding Login.OpenRegistrationCommand}"
                                            Content="Criar uma conta"
                                            Style="{StaticResource LinkButtonStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Width="340" MaxWidth="340" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Servidor indisponível" TextAlignment="Center" />
                                <TextBlock Margin="0,8,0,20" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Verifique sua internet e tente conectar novamente."
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Command="{Binding RetryConnectionCommand}"
                                        Content="Tentar novamente"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Button MinWidth="150" HorizontalAlignment="Right"
                                    Command="{Binding OpenWebCommand}" Content="Abrir versão web"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Margin="22">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Login.IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,10" Background="{DynamicResource HeroGradientBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" Background="{DynamicResource LogoTileBrush}" CornerRadius="6">
                            <Image Margin="4" Source="Resources/logo-girofy.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Text="Girofy" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Margin="0,0,12,0"
                                      Command="{Binding Settings.ToggleThemeCommand}"
                                      IsChecked="{Binding Settings.IsDarkMode, Mode=OneWay}"
                                      AutomationProperties.Name="Alternar tema"
                                      Style="{StaticResource ThemeToggleButtonStyle}" />
                        <Button x:Name="NotificationsBellButton" MinWidth="54" Margin="0,0,14,0"
                                Click="HandleNotificationsBellClick"
                                ToolTip="Notificações pendentes"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Text="🔔" />
                                <Border Margin="6,0,0,0" Padding="6,2" Background="{DynamicResource ErrorBrush}" CornerRadius="9">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Notifications.HasUnread}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentTextBrush}" Text="{Binding Notifications.UnreadText}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=NotificationsBellButton}"
                               Placement="Bottom" HorizontalOffset="-480" VerticalOffset="10"
                               AllowsTransparency="True" StaysOpen="True">
                            <views:NotificationsPopoverView DataContext="{Binding Notifications}" />
                        </Popup>
                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Login.AuthenticatedUserName}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Login.AuthenticatedCompanyName}" />
                        </StackPanel>
                        <Button MinWidth="92" Command="{Binding Login.LogoutCommand}"
                                Content="Sair" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" Background="{DynamicResource SidebarGradientBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="8" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Text="MENU" />
                        <Button Grid.Row="2" Margin="0,0,0,8" Command="{Binding ShowDashboardCommand}"
                                Content="Dashboard" Tag="&#xE80F;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="3" Margin="0,0,0,8" Command="{Binding ShowProductsCommand}"
                                Content="Produtos" Tag="&#xE7BF;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                                <Condition Binding="{Binding Catalog.IsProductsView}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="4" Command="{Binding ShowCategoriesCommand}"
                                Content="Categorias" Tag="&#xE8EC;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                                <Condition Binding="{Binding Catalog.IsCategoriesView}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="5" Margin="0,8,0,0"
                                IsEnabled="{Binding Sales.IsAvailable}"
                                Command="{Binding ShowSalesCommand}"
                                Content="Vendas" Tag="&#xE8C7;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSalesView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="6" Margin="0,8,0,0"
                                IsEnabled="{Binding CashRegister.IsAvailable}"
                                Command="{Binding ShowCashRegisterCommand}"
                                Content="Caixa" Tag="&#xE821;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashRegisterView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="7" Margin="0,8,0,0"
                                IsEnabled="{Binding Stock.CanViewStock}"
                                Command="{Binding ShowStockCommand}"
                                Content="Estoque" Tag="&#xE7B8;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStockView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="8" Margin="0,8,0,0"
                                IsEnabled="{Binding Payables.IsAvailable}"
                                Command="{Binding ShowPayablesCommand}"
                                Content="Contas a pagar" Tag="&#xE787;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPayablesView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="9" Margin="0,8,0,0"
                                IsEnabled="{Binding Reports.IsAvailable}"
                                Command="{Binding ShowReportsCommand}"
                                Content="Relatórios" Tag="&#xE9D2;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReportsView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="10" Margin="0,8,0,0"
                                IsEnabled="{Binding Audit.IsAvailable}"
                                Command="{Binding ShowAuditCommand}"
                                Content="Auditoria" Tag="&#xEA18;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuditView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="11" Margin="0,8,0,0"
                                Command="{Binding ShowSettingsCommand}"
                                Content="Configurações" Tag="&#xE713;">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarRaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:DashboardView DataContext="{Binding Dashboard}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCashRegisterView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:CashRegisterView DataContext="{Binding CashRegister}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalesView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:SalesView DataContext="{Binding Sales}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStockView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:StockView DataContext="{Binding Stock}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReportsView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:ReportsView DataContext="{Binding Reports}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuditView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:AuditView DataContext="{Binding Audit}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:SettingsView DataContext="{Binding Settings}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPayablesView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:PayablesView DataContext="{Binding Payables}" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                            <Condition Binding="{Binding Catalog.IsProductsView}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="27" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="Produtos" />
                                <TextBlock Margin="0,4,0,0" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Cadastre, edite e acompanhe o estoque dos produtos." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button MinWidth="132" Margin="0,0,10,0"
                                        Command="{Binding Catalog.OpenNewProductCommand}"
                                        Content="Novo produto" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Command="{Binding Catalog.RefreshCommand}"
                                        Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Padding="18" CornerRadius="10"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Buscar" />
                                <TextBlock Grid.Column="2" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Status" />
                                <TextBlock Grid.Column="4" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Ordenar" />

                                <TextBox Grid.Row="2"
                                         Text="{Binding Catalog.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Buscar produto"
                                         Style="{StaticResource TextInputStyle}" />
                                <ComboBox Grid.Row="2" Grid.Column="2"
                                          ItemsSource="{Binding Catalog.ActiveFilters}"
                                          SelectedItem="{Binding Catalog.SelectedActiveFilter}"
                                          DisplayMemberPath="Label" />
                                <ComboBox Grid.Row="2" Grid.Column="4"
                                          ItemsSource="{Binding Catalog.SortOptions}"
                                          SelectedItem="{Binding Catalog.SelectedSort}"
                                          DisplayMemberPath="Label" />
                                <Button Grid.Row="2" Grid.Column="6" MinWidth="108"
                                        Command="{Binding Catalog.SearchCommand}"
                                        Content="Pesquisar" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Row="2" Grid.Column="8" MinWidth="120"
                                        Command="{Binding Catalog.OpenEditProductCommand}"
                                        Content="Editar item" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Padding="12" Background="{DynamicResource ErrorSurfaceBrush}"
                                BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Catalog.HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Catalog.ErrorMessage}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="16" CornerRadius="10"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="CATEGORIAS" />
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding Catalog.Categories}"
                                             SelectedItem="{Binding Catalog.SelectedCategory, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="CategoryItemBorder"
                                                                    Padding="14,10"
                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CategoryItemBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                                    <Setter TargetName="CategoryItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="CategoryItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter TargetName="CategoryItemBorder" Property="Background" Value="{DynamicResource SelectionSoftBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" MinWidth="34" Height="26" Padding="8,0"
                                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                                            CornerRadius="13">
                                                        <TextBlock VerticalAlignment="Center" TextAlignment="Center"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="{Binding ProductCount}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Column="2" ItemsSource="{Binding Catalog.Products}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      CanUserDeleteRows="False" CanUserReorderColumns="False"
                                      CanUserResizeRows="False" SelectionMode="Single"
                                      SelectedItem="{Binding Catalog.SelectedProduct, Mode=TwoWay}"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      Background="{DynamicResource SurfaceRaisedBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      VerticalGridLinesBrush="Transparent"
                                      RowBackground="{DynamicResource SurfaceRaisedBrush}"
                                      AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                                      RowHeight="66" ColumnHeaderHeight="48">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="Clique para expandir os detalhes do produto" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2.1*" />
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="1.25*" />
                                    <DataGridTextColumn Header="Venda" Binding="{Binding SalePriceText}" Width="0.8*" />
                                    <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.75*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.7*" />
                                </DataGrid.Columns>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Margin="12,0,12,14" Padding="18"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                                BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="18" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="Detalhes completos do produto" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="12,6"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource InfoSurfaceBrush}"
                                                            BorderBrush="{DynamicResource InfoBorderBrush}"
                                                            BorderThickness="1" CornerRadius="12">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding StatusText}" />
                                                    </Border>
                                                </Grid>

                                                <UniformGrid Margin="0,18,0,0" Columns="5">
                                                    <StackPanel Margin="0,0,16,14">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="CÓDIGO DE BARRAS" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding BarcodeText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,16,14">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="CATEGORIA" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding CategoryName}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,16,14">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="TIPO" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding ProductTypeText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,14">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="SITUAÇÃO DO ESTOQUE" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding StockStatusText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,14">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="COMPOSIÇÃO DO KIT" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding KitCompositionText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="PREÇO DE CUSTO" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding CostPriceText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="PREÇO DE VENDA" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding SalePriceText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="LUCRO UNITÁRIO" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding ProfitAmountText}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="ESTOQUE ATUAL / MÍNIMO" />
                                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Text="{Binding StockText}" />
                                                            <TextBlock Margin="5,0" Foreground="{DynamicResource TextMutedBrush}"
                                                                       Text="/" />
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Text="{Binding MinStockText}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Text="MARGEM" />
                                                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding ProfitMarginText}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Catalog.ProductSummary}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Catalog.PageSummary}" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="132"
                                    Command="{Binding Catalog.OpenEditProductCommand}"
                                    Content="Editar selecionado" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="3" MinWidth="92"
                                    IsEnabled="{Binding Catalog.CanGoPrevious}"
                                    Command="{Binding Catalog.PreviousPageCommand}"
                                    Content="Anterior" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="5" MinWidth="92"
                                    IsEnabled="{Binding Catalog.CanGoNext}"
                                    Command="{Binding Catalog.NextPageCommand}"
                                    Content="Próxima" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Grid Grid.RowSpan="9" Panel.ZIndex="20" Background="{DynamicResource OverlaySoftBrush}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Catalog.IsProductEditorOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border MaxWidth="900" Margin="24" Padding="24" CornerRadius="14"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    Background="{DynamicResource HeroGradientBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="24" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Catalog.EditorTitle}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="Preencha os dados principais do produto." />
                                        </StackPanel>
                                        <Button Grid.Column="1" MinWidth="100"
                                                Command="{Binding Catalog.CloseProductEditorCommand}"
                                                Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="0.65*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Nome" />
                                            <TextBox Text="{Binding Catalog.EditorName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Código" />
                                            <TextBox Text="{Binding Catalog.EditorBarcode, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Categoria" />
                                            <ComboBox ItemsSource="{Binding Catalog.ProductCategories}"
                                                      SelectedItem="{Binding Catalog.EditorCategory}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Ativo" />
                                            <CheckBox Margin="4,14,0,0"
                                                      IsChecked="{Binding Catalog.EditorActive}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Custo" />
                                            <TextBox Text="{Binding Catalog.EditorCostPrice, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Venda" />
                                            <TextBox Text="{Binding Catalog.EditorSalePrice, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="4">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Estoque" />
                                            <TextBox Text="{Binding Catalog.EditorStockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="6">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Mínimo" />
                                            <TextBox Text="{Binding Catalog.EditorMinStockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Tipo" />
                                            <CheckBox Content="Produto kit"
                                                      IsChecked="{Binding Catalog.EditorIsKit}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Produto-base" />
                                            <ComboBox ItemsSource="{Binding Catalog.KitComponentProducts}"
                                                      SelectedItem="{Binding Catalog.EditorKitComponent}"
                                                      DisplayMemberPath="Name"
                                                      IsEnabled="{Binding Catalog.EditorIsKit}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="Quantidade consumida" />
                                            <TextBox Text="{Binding Catalog.EditorKitComponentQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding Catalog.EditorIsKit}"
                                                     ToolTip="Quantidade do produto-base consumida por unidade do kit"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="6">
                                        <TextBlock Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="Motivo do estoque" />
                                        <TextBox Text="{Binding Catalog.EditorStockReason, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Motivo do ajuste de estoque"
                                                 Style="{StaticResource TextInputStyle}" />
                                    </StackPanel>

                                    <Grid Grid.Row="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="Os valores usam o mesmo cadastro da versão web." />
                                        <Button Grid.Column="1" MinWidth="120"
                                                Click="DeleteSelectedProduct_Click"
                                                CommandParameter="{Binding Catalog.SelectedProduct}"
                                                Content="Excluir produto">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Catalog.IsEditingProduct}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="3" MinWidth="110"
                                                Command="{Binding Catalog.CloseProductEditorCommand}"
                                                Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="5" MinWidth="130"
                                                Command="{Binding Catalog.SaveProductCommand}"
                                                Content="Salvar produto" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCatalogView}" Value="True" />
                                            <Condition Binding="{Binding Catalog.IsCategoriesView}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="27" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="Categorias" />
                                <TextBlock Margin="0,4,0,0" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Organização atual dos produtos da adega." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button MinWidth="132" Command="{Binding Catalog.OpenNewCategoryCommand}"
                                        Content="Nova categoria" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="126"
                                        Command="{Binding Catalog.OpenEditCategoryCommand}"
                                        Content="Editar" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="126"
                                        Command="{Binding Catalog.DeleteCategoryCommand}"
                                        Content="Excluir" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="112" Command="{Binding Catalog.RefreshCommand}"
                                        Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.RowSpan="5" Panel.ZIndex="20"
                              Background="{DynamicResource OverlaySoftBrush}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Catalog.IsCategoryEditorOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border Width="560" Margin="24" Padding="24" CornerRadius="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource HeroGradientBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="24" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Catalog.CategoryEditorTitle}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="Organize os produtos cadastrando uma categoria." />
                                        </StackPanel>
                                        <Button Grid.Column="1" MinWidth="92"
                                                Command="{Binding Catalog.CloseCategoryEditorCommand}"
                                                Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Nome da categoria" />
                                        <TextBox Text="{Binding Catalog.CategoryEditorName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}" />
                                        <TextBlock Margin="0,7,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="Use um nome curto e fácil de identificar." />
                                    </StackPanel>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="A categoria ficará disponível no cadastro de produtos." />
                                        <Button Grid.Column="1" MinWidth="104"
                                                Command="{Binding Catalog.CloseCategoryEditorCommand}"
                                                Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="3" MinWidth="142"
                                                Command="{Binding Catalog.SaveCategoryCommand}"
                                                Content="Salvar categoria" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding Catalog.CategoryRows}"
                                  SelectedItem="{Binding Catalog.SelectedCategoryRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column" EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Background="{DynamicResource SurfaceRaisedBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  VerticalGridLinesBrush="Transparent"
                                  RowBackground="{DynamicResource SurfaceRaisedBrush}"
                                  AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                                  RowHeight="50" ColumnHeaderHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Produtos" Binding="{Binding ProductCount}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid Panel.ZIndex="100"
              Background="{DynamicResource OverlaySoftBrush}"
              PreviewKeyDown="HandleForgotPasswordKeyDown">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Login.ForgotPassword.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="460" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Recuperar senha" />
                    <TextBlock Margin="0,8,0,20"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Informe seu usuário ou e-mail. Enviaremos um link para redefinir sua senha."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,7" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Usuário ou e-mail" />
                    <TextBox x:Name="ForgotPasswordIdentifierInput"
                             Text="{Binding Login.ForgotPassword.Identifier, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextInputStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Login.ForgotPassword.IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Border Margin="0,16,0,0" Padding="12"
                            Background="{DynamicResource ErrorSurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Login.ForgotPassword.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Login.ForgotPassword.ErrorMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Border Margin="0,16,0,0" Padding="12"
                            Background="{DynamicResource SuccessSurfaceBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Login.ForgotPassword.IsSuccess}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Login.ForgotPassword.SuccessMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding Login.ForgotPassword.CancelCommand}"
                                Content="Voltar" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" IsDefault="True"
                                Command="{Binding Login.ForgotPassword.SubmitCommand}"
                                Content="{Binding Login.ForgotPassword.SubmitButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
