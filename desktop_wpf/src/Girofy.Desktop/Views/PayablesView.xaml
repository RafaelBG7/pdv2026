<UserControl x:Class="Girofy.Desktop.Views.PayablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PayablesCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="PayablesLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PayablesMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="PayablesMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,9,0,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PayablesStatusButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeInput}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="{DynamicResource FontSizeHero}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Contas a pagar" />
                    <TextBlock Margin="0,7,0,0" FontSize="{DynamicResource FontSizeInput}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Cadastre despesas como aluguel, luz e fornecedores." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FilterByStatusCommand}" CommandParameter="open" Content="Pendentes"
                            Tag="{Binding IsPendingFilter}" Style="{StaticResource PayablesStatusButtonStyle}" />
                    <Button Command="{Binding FilterByStatusCommand}" CommandParameter="paid" Content="Pagas"
                            Tag="{Binding IsPaidFilter}" Style="{StaticResource PayablesStatusButtonStyle}" />
                    <Button Command="{Binding FilterByStatusCommand}" CommandParameter="all" Content="Todas"
                            Tag="{Binding IsAllFilter}" Style="{StaticResource PayablesStatusButtonStyle}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource ErrorSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Padding="12" Background="{DynamicResource SuccessSurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasSuccess}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <UniformGrid Grid.Row="4" Columns="3">
                <Border Margin="0,0,8,0" Style="{StaticResource PayablesCardStyle}"><StackPanel>
                    <TextBlock Style="{StaticResource PayablesMetricLabelStyle}" Text="Total pendente" />
                    <TextBlock Style="{StaticResource PayablesMetricValueStyle}" Text="{Binding Summary.OpenAmountText}" />
                    <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Summary.OpenCountText}" />
                </StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource PayablesCardStyle}"><StackPanel>
                    <TextBlock Style="{StaticResource PayablesMetricLabelStyle}" Text="Vencidas" />
                    <TextBlock Style="{StaticResource PayablesMetricValueStyle}" Text="{Binding Summary.OverdueAmountText}" />
                </StackPanel></Border>
                <Border Margin="8,0,0,0" Style="{StaticResource PayablesCardStyle}"><StackPanel>
                    <TextBlock Style="{StaticResource PayablesMetricLabelStyle}" Text="Vencem em até 3 dias" />
                    <TextBlock Style="{StaticResource PayablesMetricValueStyle}" Text="{Binding Summary.DueSoonAmountText}" />
                </StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="6" Style="{StaticResource PayablesCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Nova conta" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Descrição" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex.: aluguel, luz ou internet" Style="{StaticResource TextInputStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Categoria" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding CategoryText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Valor" />
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="0,00" Style="{StaticResource TextInputStyle}" /></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Vencimento" />
                            <TextBox Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="DD/MM/AAAA" Style="{StaticResource TextInputStyle}" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Observação" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Opcional" Style="{StaticResource TextInputStyle}" /></StackPanel>
                        <Button Grid.Column="2" MinWidth="118" VerticalAlignment="Bottom" Command="{Binding ClearFormCommand}"
                                Content="Limpar" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="4" MinWidth="154" VerticalAlignment="Bottom" Command="{Binding CreatePayableCommand}"
                                Content="Cadastrar conta" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="8" Style="{StaticResource PayablesCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Pesquisa e filtros" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Refine por texto, categoria ou período." /></StackPanel>
                        <Button Grid.Column="1" MinWidth="108" Command="{Binding RefreshCommand}" Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Busca" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Descrição ou observação" Style="{StaticResource TextInputStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Categoria" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Data inicial" />
                            <TextBox Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="DD/MM/AAAA" Style="{StaticResource TextInputStyle}" /></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource PayablesLabelStyle}" Text="Data final" />
                            <TextBox Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="DD/MM/AAAA" Style="{StaticResource TextInputStyle}" /></StackPanel>
                        <Button Grid.Column="8" MinWidth="112" VerticalAlignment="Bottom" Command="{Binding ApplyFiltersCommand}"
                                Content="Filtrar" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="10" Padding="0" Style="{StaticResource PayablesCardStyle}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Payables}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single"
                              RowHeight="56" ColumnHeaderHeight="44" MinHeight="150" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CONTA" Binding="{Binding Description}" Width="2*" />
                            <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Category}" Width="1.1*" />
                            <DataGridTextColumn Header="VENCIMENTO" Binding="{Binding DueDateText}" Width="1*" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="1*" />
                            <DataGridTextColumn Header="VALOR" Binding="{Binding AmountText}" Width="1*" />
                            <DataGridTemplateColumn Header="AÇÃO" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button MinWidth="72" Command="{Binding DataContext.PayPayableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Content="Pagar"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers><DataTrigger Binding="{Binding CanPay}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style></Button.Style></Button>
                                    <Button MinWidth="82" Command="{Binding DataContext.ReopenPayableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Content="Reabrir"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers><DataTrigger Binding="{Binding CanReopen}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style></Button.Style></Button>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeInput}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="Nenhuma conta encontrada.">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
