                                                     PreviewKeyDown="ProductBarcodeInput_PreviewKeyDown"
                                                     Style="{StaticResource TextInputStyle}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="{DynamicResource FontSizeTiny}"
