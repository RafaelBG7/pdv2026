<UserControl x:Class="Girofy.Desktop.Views.PayablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Contas a pagar" />
                    <TextBlock Margin="0,4,0,0" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Controle vencimentos, contas pagas e despesas próximas." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Padding="12" Margin="0,0,0,8"
                        Background="{DynamicResource ErrorSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Padding="12"
                        Background="{DynamicResource SuccessSurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <UniformGrid Grid.Row="4" Columns="4">
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="ABERTAS" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Text="{Binding Summary.OpenAmountText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Summary.OpenCountText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="VENCIDAS" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Text="{Binding Summary.OverdueAmountText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="PRÓXIMAS" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Text="{Binding Summary.DueSoonAmountText}" />
                    </StackPanel>
                </Border>
                <Border Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="PAGAS" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding Summary.PaidCountText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="6" Padding="18"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Filtros" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Busca" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Buscar conta por descrição ou observação"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Status" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Categoria" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Data inicial" />
                            <TextBox Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="AAAA-MM-DD ou DD/MM/AAAA"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Data final" />
                            <TextBox Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="AAAA-MM-DD ou DD/MM/AAAA"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>

                        <Button Grid.Row="2" Grid.ColumnSpan="5" MinWidth="150"
                                Command="{Binding ApplyFiltersCommand}"
                                Content="Filtrar"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="3" MinWidth="150"
                                Command="{Binding RefreshCommand}"
                                Content="Limpar e atualizar"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="8" Padding="18"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Nova conta" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Descrição" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Categoria" />
                            <TextBox Text="{Binding CategoryText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Valor" />
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Vencimento" />
                            <TextBox Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="AAAA-MM-DD ou DD/MM/AAAA"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="7">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Observações" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <Button Grid.Row="4" Grid.ColumnSpan="3" MinWidth="150"
                                Command="{Binding CreatePayableCommand}"
                                Content="Cadastrar conta"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="3" MinWidth="150"
                                Command="{Binding ClearFormCommand}"
                                Content="Limpar formulário"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <DataGrid Grid.Row="10" ItemsSource="{Binding Payables}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserReorderColumns="False"
                      CanUserResizeRows="False" SelectionMode="Single"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Background="{DynamicResource SurfaceRaisedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="Transparent"
                      RowBackground="{DynamicResource SurfaceRaisedBrush}"
                  AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                      RowHeight="56" ColumnHeaderHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="1.1*" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding AmountText}" Width="1*" />
                    <DataGridTextColumn Header="Vencimento" Binding="{Binding DueDateText}" Width="1*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="1*" />
                    <DataGridTextColumn Header="Observações" Binding="{Binding NotesText}" Width="1.5*" />
                    <DataGridTemplateColumn Header="Ação" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button MinWidth="70"
                                            Command="{Binding DataContext.PayPayableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Pagar">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanPay}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button MinWidth="80"
                                            Command="{Binding DataContext.ReopenPayableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Reabrir">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanReopen}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
