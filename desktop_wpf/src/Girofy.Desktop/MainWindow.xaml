                            <Button Grid.Column="5" MinWidth="92"
                                    IsEnabled="{Binding Catalog.CanGoNext}"
                                    Command="{Binding Catalog.NextPageCommand}"
                                    Content="Próxima" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Grid Grid.RowSpan="9" Panel.ZIndex="20" Background="{DynamicResource OverlaySoftBrush}">
