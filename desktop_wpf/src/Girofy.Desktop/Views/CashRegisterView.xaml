<UserControl x:Class="Girofy.Desktop.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly"
                  ScrollViewer.IsDeferredScrollingEnabled="True">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Caixa" />
                    <TextBlock Margin="0,4,0,0" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Abra, acompanhe e feche o caixa da sua adega." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Margin="0,0,0,18" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button MinWidth="132" Height="42"
                                Command="{Binding ShowCurrentRegisterTabCommand}"
                                Content="Caixa atual">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentRegisterTabSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button MinWidth="158" Height="42" Margin="8,0,0,0"
                                Command="{Binding ShowPreviousRegistersTabCommand}"
                                Content="Caixas anteriores">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviousRegistersTabSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Padding="12" Margin="0,0,0,8"
                        Background="{StaticResource ErrorSurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Padding="12"
                        Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Padding="22"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasNoOpenRegister}" Value="True" />
                                    <Condition Binding="{Binding IsCurrentRegisterTabSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Caixa fechado" />
                        <TextBlock Margin="0,5,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Informe o valor disponível para iniciar as vendas do turno."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Valor inicial" />
                            <TextBox Text="{Binding OpeningAmountText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Valor inicial em reais"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" MinWidth="156" Margin="0,20,0,0"
                                Command="{Binding OpenCommand}"
                                Content="Abrir caixa"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="Transparent" BorderThickness="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasOpenRegister}" Value="True" />
                                    <Condition Binding="{Binding IsCurrentRegisterTabSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.NumberText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Resumo do caixa atual em operação" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,6"
                                Background="{StaticResource SuccessSurfaceBrush}"
                                BorderBrush="{StaticResource SuccessBorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="Aberto" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="20" Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Resumo do caixa" />
                                <TextBlock Margin="0,4,0,16" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding CurrentRegister.OpenedAtText}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Responsável" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding CurrentRegister.ResponsibleUser}" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Vendas realizadas" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding CurrentRegister.SalesCountText}" />
                                </Grid>
                                <Border Height="1" Margin="0,4,0,14" Background="{StaticResource BorderBrush}" />
                                <UniformGrid Columns="3">
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="SALDO INICIAL" />
                                        <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding CurrentRegister.OpeningAmountText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="TOTAL VENDIDO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"
                                                   Text="{Binding CurrentRegister.SalesTotalText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="SALDO ESPERADO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                                   Text="{Binding CurrentRegister.ExpectedAmountText}" />
                                    </StackPanel>
                                </UniformGrid>
                                <Border Margin="0,20,0,0" Padding="14" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Valor contado" />
                                            <TextBox Margin="0,7,0,0" Text="{Binding ClosingAmountText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Valor contado no caixa em reais" Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" MinWidth="138" Margin="0,19,0,0" Command="{Binding CloseCommand}"
                                                Content="Fechar caixa" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="20" Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Meios de pagamento" />
                                <TextBlock Margin="0,4,0,14" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Totais recebidos neste caixa" />
                                <ItemsControl ItemsSource="{Binding CurrentRegister.PaymentTotals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,0" MinHeight="44">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" VerticalAlignment="Center" Background="{StaticResource InfoSurfaceBrush}"
                                                        BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                                                               Foreground="{StaticResource InfoBrush}" Text="●" />
                                                </Border>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Label}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding AmountText}" />
                                                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Saldo final esperado" />
                                    <TextBlock Grid.Column="1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding CurrentRegister.ExpectedAmountText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Padding="18"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Histórico de vendas do caixa atual" />
                            <TextBlock Margin="0,4,0,12" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Clique em uma venda para conferir o saldo acumulado antes e depois dela." />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Nenhuma venda registrada neste caixa.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoCurrentTimeline}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding CurrentTimeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,8">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding HeaderText}" />
                                                    <TextBlock Grid.Column="1" Margin="18,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding PaymentsText}" />
                                                    <TextBlock Grid.Column="2" Margin="18,0,0,0" FontWeight="Bold"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               Text="{Binding FinalAmountText}" />
                                                </Grid>
                                            </Expander.Header>
                                            <Border Margin="16,10,16,12" Padding="12"
                                                    Background="{StaticResource InfoSurfaceBrush}"
                                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="SALDO ANTES DA VENDA" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="{Binding BalanceBeforeSaleText}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="SALDO APÓS A VENDA" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="Bold"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   Text="{Binding BalanceAfterSaleText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviousRegistersTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Histórico de caixas" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Selecione uma linha para consultar resumo, pagamentos e movimentações." />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="112" Command="{Binding RefreshCommand}"
                            Content="Atualizar lista" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <DataGrid ItemsSource="{Binding RecentRegisters}"
                          x:Name="RecentRegistersGrid"
                          MaxHeight="620"
                          SelectedItem="{Binding SelectedRegister, Mode=TwoWay}"
                          PreviewMouseLeftButtonDown="RecentRegistersGrid_PreviewMouseLeftButtonDown"
                          SelectionChanged="RecentRegistersGrid_SelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeRows="False" SelectionMode="Single"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="Transparent"
                          RowBackground="{StaticResource SurfaceRaisedBrush}"
                          AlternatingRowBackground="#102034"
                          RowHeight="54" ColumnHeaderHeight="40">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentRegisters}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Clique para abrir; clique novamente para recolher" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource InfoSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,1,0,1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Ação" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource InfoSurfaceBrush}" CornerRadius="5">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Abrir" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Text" Value="Recolher" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Caixa" Binding="{Binding NumberText}" Width="0.8*" />
                        <DataGridTextColumn Header="Abertura" Binding="{Binding OpenedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Fechamento" Binding="{Binding ClosedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Responsável" Binding="{Binding ResponsibleUser}" Width="1.1*" />
                        <DataGridTextColumn Header="Vendas" Binding="{Binding SalesCountText}" Width="0.85*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding SalesTotalText}" Width="0.9*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.75*" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Margin="10,0,10,14" Padding="18"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Carregando detalhes do caixa...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDetailLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.NumberText}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding DetailRegister.ResponsibleUser, Mode=OneWay}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding DetailRegister.StatusText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" MinWidth="128"
                                                    Command="{Binding LoadRegisterDetailCommand}"
                                                    Content="Atualizar detalhe"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>

                                        <UniformGrid Margin="0,16,0,0" Columns="4">
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}" Text="ABERTURA" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.OpenedAtText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,12">
