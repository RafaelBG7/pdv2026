<UserControl x:Class="Girofy.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Dashboard"/><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.ReferenceDateText, FallbackValue=Visão consolidada da operação}"/></StackPanel>
                <ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
                <DatePicker Grid.Column="3" Width="125" SelectedDate="{Binding CustomStartDate}" ToolTip="Data inicial"><DatePicker.Style><Style TargetType="DatePicker"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomPeriod}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DatePicker.Style></DatePicker>
                <DatePicker Grid.Column="5" Width="125" SelectedDate="{Binding CustomEndDate}" ToolTip="Data final"><DatePicker.Style><Style TargetType="DatePicker"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomPeriod}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DatePicker.Style></DatePicker>
                <Button Grid.Column="7" MinWidth="90" Command="{Binding ApplyPeriodCommand}" Content="Aplicar" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Grid.Column="9" MinWidth="160" Command="{Binding DataContext.StartSaleCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Realizar venda — F3" Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>

            <Border Margin="0,0,0,16" Padding="13" Background="{DynamicResource ErrorSurfaceBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="7"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/></Border>
            <Border MinHeight="170" Padding="24" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasData}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="220" Height="4" IsIndeterminate="{Binding IsBusy}"/><TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EmptyMessage}"/></StackPanel>
            </Border>

            <StackPanel>
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasData}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Margin="0,0,7,0" Padding="18" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="FATURAMENTO"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Snapshot.Summary.SalesTotalText}"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.Summary.SalesTotalChangeText}"/></StackPanel></Border>
                    <Border Margin="7,0" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="VENDAS"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Snapshot.Summary.SalesCountText}"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.Summary.SalesCountChangeText}"/></StackPanel></Border>
                    <Border Margin="7,0" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="CLIENTES"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="—"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Módulo ainda não ativado"/></StackPanel></Border>
                    <Border Margin="7,0,0,0" Padding="18" Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="LUCRO ESTIMADO"/><TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Snapshot.Summary.ProfitText}"/><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snapshot.Summary.ProfitChangeText}"/></StackPanel></Border>
                </UniformGrid>

                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Faturamento no período"/><ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Snapshot.RevenueSeries.Points}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Label}"/><ProgressBar Grid.Column="1" Height="8" Maximum="1" Value="{Binding Ratio}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding TotalText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Vendas por categoria"/><ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Snapshot.CategorySales}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Category}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SummaryText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </Grid>

                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Produtos mais vendidos"/><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Snapshot.TopProducts}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Category}"/></StackPanel><TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding QuantityText}"/><TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding TotalText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Vendas recentes"/><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Snapshot.RecentSales}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding NumberText}"/><StackPanel Grid.Column="1"><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding UserName}"/><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PaymentText}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding FinalAmountText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
