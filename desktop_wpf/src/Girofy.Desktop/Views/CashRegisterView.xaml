<UserControl x:Class="Girofy.Desktop.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Caixa" />
                    <TextBlock Margin="0,4,0,0" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Abra, acompanhe e feche o caixa da sua adega." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Margin="0,0,0,16" Padding="6"
                        HorizontalAlignment="Left"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Button MinWidth="150" Height="40"
                                Command="{Binding ShowCurrentRegisterTabCommand}"
                                Content="Caixa atual">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentRegisterTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource InfoSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button MinWidth="170" Height="40" Margin="6,0,0,0"
                                Command="{Binding ShowPreviousRegistersTabCommand}"
                                Content="Caixas anteriores">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviousRegistersTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource InfoSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Padding="12" Margin="0,0,0,8"
                        Background="{StaticResource ErrorSurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Padding="12"
                        Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Padding="22"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasNoOpenRegister}" Value="True" />
                                    <Condition Binding="{Binding IsCurrentRegisterTabSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Caixa fechado" />
                        <TextBlock Margin="0,5,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Informe o valor disponível para iniciar as vendas do turno."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Valor inicial" />
                            <TextBox Text="{Binding OpeningAmountText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Valor inicial em reais"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" MinWidth="156" Margin="0,20,0,0"
                                Command="{Binding OpenCommand}"
                                Content="Abrir caixa"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="22"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasOpenRegister}" Value="True" />
                                    <Condition Binding="{Binding IsCurrentRegisterTabSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="21" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.NumberText}" />
                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Caixa atual em operação" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,6"
                                Background="{StaticResource SuccessSurfaceBrush}"
                                BorderBrush="{StaticResource SuccessBorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="Aberto" />
                        </Border>
                    </Grid>

                    <UniformGrid Margin="0,18,0,0" Columns="3">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="ABERTO EM" />
                            <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.OpenedAtText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="RESPONSÁVEL" />
                            <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.ResponsibleUser}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="MOVIMENTO" />
                            <TextBlock Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding CurrentRegister.SalesCountText}" />
                        </StackPanel>
                    </UniformGrid>

                    <Border Margin="0,20,0,0" Padding="16"
                            Background="{StaticResource InfoSurfaceBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="VALOR INICIAL" />
                                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding CurrentRegister.OpeningAmountText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="TOTAL VENDIDO" />
                                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource InfoBrush}"
                                               Text="{Binding CurrentRegister.SalesTotalText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="VALOR ESPERADO" />
                                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding CurrentRegister.ExpectedAmountText}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Margin="0,18,0,8" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="TOTAL POR FORMA DE PAGAMENTO" />
                            <ItemsControl ItemsSource="{Binding CurrentRegister.PaymentTotals}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,8" Padding="12,8"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding Label}" />
                                                <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding AmountText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Fechar caixa" />
                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Conte o valor disponível e informe o total exato."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Valor contado" />
                                    <TextBox Text="{Binding ClosingAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Valor contado no caixa em reais"
                                             Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="156" Margin="0,20,0,0"
                                        Command="{Binding CloseCommand}"
                                        Content="Fechar caixa"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviousRegistersTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Caixas anteriores" />
                <TextBlock Margin="0,4,0,12" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Consulte os caixas encerrados e abra os detalhes somente quando precisar." />
                <DataGrid ItemsSource="{Binding RecentRegisters}"
                          x:Name="RecentRegistersGrid"
                          SelectedItem="{Binding SelectedRegister, Mode=TwoWay}"
                          SelectionChanged="RecentRegistersGrid_SelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeRows="False" SelectionMode="Single"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="Transparent"
                          RowBackground="{StaticResource SurfaceRaisedBrush}"
                          AlternatingRowBackground="#102034"
                          RowHeight="50" ColumnHeaderHeight="42">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentRegisters}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Caixa" Binding="{Binding NumberText}" Width="0.8*" />
                        <DataGridTextColumn Header="Abertura" Binding="{Binding OpenedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Fechamento" Binding="{Binding ClosedAtText}" Width="1.25*" />
                        <DataGridTextColumn Header="Responsável" Binding="{Binding ResponsibleUser}" Width="1.1*" />
                        <DataGridTextColumn Header="Vendas" Binding="{Binding SalesCountText}" Width="0.85*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding SalesTotalText}" Width="0.9*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.75*" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Margin="10,0,10,14" Padding="18"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Carregando detalhes do caixa...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDetailLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.NumberText}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding DetailRegister.ResponsibleUser}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding DetailRegister.StatusText}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" MinWidth="128"
                                                    Command="{Binding LoadRegisterDetailCommand}"
                                                    Content="Atualizar detalhe"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>

                                        <UniformGrid Margin="0,16,0,0" Columns="4">
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}" Text="ABERTURA" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.OpenedAtText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}" Text="FECHAMENTO" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.ClosedAtText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}" Text="VENDAS" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.SalesCountText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}" Text="TOTAL VENDIDO" />
                                                <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource InfoBrush}"
                                                           Text="{Binding DetailRegister.SalesTotalText}" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <Border Margin="0,4,0,0" Padding="14"
                                                Background="{StaticResource InfoSurfaceBrush}"
                                                BorderBrush="{StaticResource InfoBorderBrush}"
                                                BorderThickness="1" CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="VALOR INICIAL" />
                                                        <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="{Binding DetailRegister.OpeningAmountText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="VALOR FINAL" />
                                                        <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="{Binding DetailRegister.ClosingAmountText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="VALOR ESPERADO" />
                                                        <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="{Binding DetailRegister.ExpectedAmountText}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Margin="0,4,0,8" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="Formas de pagamento" />
                                                <ItemsControl ItemsSource="{Binding DetailRegister.PaymentTotals}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,10,8" Padding="11,7"
                                                                    Background="{StaticResource SurfaceRaisedBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="5">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="{Binding Label}" />
                                                                    <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               Text="{Binding AmountText}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Margin="0,18,0,10" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="Linha do tempo de vendas" />
                                        <TextBlock Margin="0,0,0,8" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="Nenhuma venda vinculada a este caixa.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoTimeline}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Timeline}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Margin="0,0,0,9">
                                                        <Expander.Header>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           Text="{Binding HeaderText}" />
                                                                <TextBlock Grid.Column="1" Margin="18,0,0,0"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Text="{Binding PaymentsText}" />
                                                                <TextBlock Grid.Column="2" Margin="18,0,0,0" FontWeight="Bold"
                                                                           Foreground="{StaticResource SuccessBrush}"
                                                                           Text="{Binding FinalAmountText}" />
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Margin="16,12,16,12">
                                                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="Produtos vendidos" />
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="90" />
                                                                                <ColumnDefinition Width="110" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                                                       Text="{Binding ProductName}" TextWrapping="Wrap" />
                                                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       Text="{Binding QuantityText}" />
                                                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                                       Text="{Binding TotalPriceText}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Margin="0,10,0,7" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="Pagamentos" />
                                                            <ItemsControl ItemsSource="{Binding Payments}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,10,7" Padding="10,6"
                                                                                Background="{StaticResource InfoSurfaceBrush}"
                                                                                BorderBrush="{StaticResource InfoBorderBrush}"
                                                                                BorderThickness="1" CornerRadius="5">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                                           Text="{Binding Label}" />
                                                                                <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                                           Text="{Binding AmountText}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <Border Margin="0,14,0,0" Padding="22"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoRecentRegisters}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Nenhum caixa anterior encontrado" />
                        <TextBlock Margin="0,5,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Os caixas encerrados aparecerão aqui." />
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Clique em qualquer caixa para abrir vendas, itens e pagamentos." />
                    <Button Grid.Column="1" MinWidth="150"
                            Command="{Binding LoadRegisterDetailCommand}"
                            Content="Atualizar detalhe"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <Border Margin="0,14,0,0" Padding="12" Visibility="Collapsed"
                        Background="{StaticResource InfoSurfaceBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Carregando detalhes do caixa..." />
                </Border>

                <Border Margin="0,16,0,0" Padding="18" Visibility="Collapsed"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.NumberText}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding DetailRegister.StatusText}" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="118"
                                    Command="{Binding ClearRegisterDetailCommand}"
                                    Content="Fechar"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <UniformGrid Margin="0,16,0,0" Columns="4">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="ABERTURA" />
                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.OpenedAtText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="FECHAMENTO" />
                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.ClosedAtText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="RESPONSÁVEL" />
                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.ResponsibleUser}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="VENDAS" />
                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DetailRegister.SalesCountText}" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Margin="0,16,0,0" Padding="14"
                                Background="{StaticResource InfoSurfaceBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanViewFinancials}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="VALOR INICIAL" />
                                        <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding DetailRegister.OpeningAmountText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="TOTAL VENDIDO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource InfoBrush}"
                                                   Text="{Binding DetailRegister.SalesTotalText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="FECHAMENTO" />
                                        <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding DetailRegister.ClosingAmountText}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Margin="0,14,0,8" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Pagamentos do caixa" />
                                <ItemsControl ItemsSource="{Binding DetailRegister.PaymentTotals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,10,8" Padding="12,8"
                                                    Background="{StaticResource SurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding AmountText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,10" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Linha do tempo de vendas" />
                        <TextBlock Margin="0,0,0,8" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Nenhuma venda vinculada a este caixa.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoTimeline}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding HeaderText}" />
                                                <TextBlock Grid.Column="1" Margin="18,0,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding PaymentsText}" />
                                                <TextBlock Grid.Column="2" Margin="18,0,0,0"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Text="{Binding FinalAmountText}" />
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Margin="16,12,16,14">
                                            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Produtos vendidos" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="110" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Text="{Binding ProductName}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding QuantityText}" />
                                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding UnitPriceText}" />
                                                            <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Text="{Binding TotalPriceText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Margin="0,10,0,8" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Pagamentos" />
                                            <ItemsControl ItemsSource="{Binding Payments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,10,8" Padding="10,7"
                                                                Background="{StaticResource InfoSurfaceBrush}"
                                                                BorderBrush="{StaticResource InfoBorderBrush}"
                                                                BorderThickness="1" CornerRadius="5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Text="{Binding Label}" />
                                                                <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           Text="{Binding AmountText}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
