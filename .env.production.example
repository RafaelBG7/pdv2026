# Exemplo sem segredos. A produção real continua em /opt/girofy/app/.env.
APP_ENV=production
APP_VERSION=unknown
FLASK_DEBUG=0
PUBLIC_BASE_URL=https://skygest.com.br
SECRET_KEY=gere-uma-chave-exclusiva-para-producao
API_TOKEN_SECRET=gere-outra-chave-exclusiva-para-producao
MASTER_DEFAULT_USERNAME=master
MASTER_DEFAULT_PASSWORD=defina-fora-do-git
CSRF_ENABLED=1
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
API_ALLOW_INSECURE_AUTH=0
TRUST_PROXY_HEADERS=1
TRUSTED_PROXY_COUNT=1
SCHEMA_MANAGEMENT_MODE=verify
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_IN_MEMORY_FALLBACK_ENABLED=0
RATELIMIT_KEY_PREFIX=skygest-prod
MAIL_SUPPRESS_SEND=0
SUBSCRIPTION_COMMERCIAL_ENABLED=1

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=adega_central
MYSQL_USER=girofy_app
MYSQL_PASSWORD=defina-fora-do-git
MYSQL_ROOT_PASSWORD=defina-fora-do-git
MYSQL_TENANT_DATABASE_PREFIX=adega

GIROFY_SITE_ADDRESS=:18080
GIROFY_PUBLIC_HTTP_PORT=18080
GIROFY_BACKUP_HOST_DIR=/opt/girofy/backups
AUTO_BACKUP_ENABLED=1
AUTO_BACKUP_INTERVAL_SECONDS=86400
AUTO_BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_RETENTION_COUNT=30
