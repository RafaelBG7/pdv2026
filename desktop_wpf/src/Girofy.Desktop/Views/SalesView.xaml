<UserControl x:Class="Girofy.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Realizar venda" />
                    <TextBlock Margin="0,4,0,0" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Pesquise, monte o pedido e confirme o pagamento sem sair do aplicativo." />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding CartSummary}" />
            </Grid>

            <Border Grid.Row="2" Padding="12" Background="{StaticResource ErrorSurfaceBrush}"
                    BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="4" Padding="12" Background="{StaticResource SuccessSurfaceBrush}"
                    BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="6">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="18" Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Adicionar produto" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Buscar produto por nome ou código de barras"
                                     Style="{StaticResource TextInputStyle}" />
                            <Button Grid.Column="2" MinWidth="112" Command="{Binding SearchCommand}"
                                    Content="Pesquisar" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                        <DataGrid Grid.Row="4" MaxHeight="165"
                                  ItemsSource="{Binding SearchResults}"
                                  SelectedItem="{Binding SelectedSearchProduct}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  EnableRowVirtualization="True"
                                  Background="{StaticResource SurfaceBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  VerticalGridLinesBrush="Transparent"
                                  RowBackground="{StaticResource SurfaceBrush}"
                                  RowHeight="42" ColumnHeaderHeight="36">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="1.1*" />
                                <DataGridTextColumn Header="Preço" Binding="{Binding SalePriceText}" Width="1*" />
                                <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.9*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           Text="PRODUTO SELECIONADO" />
                                <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding SelectedSearchProduct.Name, TargetNullValue='Selecione um resultado'}" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Quantidade" Style="{StaticResource TextInputStyle}" />
                            <Button Grid.Column="4" MinWidth="112" Command="{Binding AddProductCommand}"
                                    Content="Adicionar" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="18" Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Itens do pedido" />
                        <DataGrid Grid.Row="2" MinHeight="112" MaxHeight="250"
                                  ItemsSource="{Binding CartItems}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  EnableRowVirtualization="True"
                                  Background="{StaticResource SurfaceBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  VerticalGridLinesBrush="Transparent"
                                  RowBackground="{StaticResource SurfaceBrush}"
                                  AlternatingRowBackground="#102034"
                                  RowHeight="54" ColumnHeaderHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Unitário" Binding="{Binding UnitPriceText}" Width="1*" />
                                <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.8*" />
                                <DataGridTemplateColumn Header="Quantidade" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Width="34" Height="32" Content="−"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBlock Width="54" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextAlignment="Center"
                                                           FontWeight="SemiBold" Text="{Binding Quantity}" />
                                                <Button Width="34" Height="32" Content="+"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding LineTotalText}" Width="1*" />
                                <DataGridTemplateColumn Header="Ação" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Height="32" Content="Remover"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Padding="18" Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Pagamento" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Desconto" />
                                <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Subtotal" />
                                <Border Height="48" Padding="12" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding SubtotalText}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Total a pagar" />
                                <Border Height="48" Padding="12" Background="{StaticResource SuccessSurfaceBrush}"
                                        BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding TotalText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Dinheiro" />
                                    <TextBox Text="{Binding MoneyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="0,25,0,0" Command="{Binding FillMoneyCommand}"
                                        Content="Completar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Pix" />
                                    <TextBox Text="{Binding PixText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="0,25,0,0" Command="{Binding FillPixCommand}"
                                        Content="Completar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Débito" />
                                    <TextBox Text="{Binding DebitText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="0,25,0,0" Command="{Binding FillDebitCommand}"
                                        Content="Completar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Crédito" />
                                    <TextBox Text="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="0,25,0,0" Command="{Binding FillCreditCommand}"
                                        Content="Completar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="8" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="PAGO" />
                                <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding PaidAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="FALTA" />
                                <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource ErrorBrush}" Text="{Binding MissingAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TROCO" />
                                <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoBrush}" Text="{Binding ChangeAmountText}" />
                            </StackPanel>
                            <Button Grid.Column="3" MinWidth="190" Height="52"
                                    Command="{Binding FinalizeCommand}"
                                    Content="Finalizar venda" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="6" Padding="28" Background="{StaticResource SuccessSurfaceBrush}"
                    BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="Venda concluída" />
                    <TextBlock Margin="0,5,0,22" HorizontalAlignment="Center" FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding Receipt.SaleNumberText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TOTAL" />
                            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" Text="{Binding Receipt.FinalAmountText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="PAGO" />
                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Receipt.PaidAmountText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TROCO" />
                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource InfoBrush}" Text="{Binding Receipt.ChangeAmountText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="CAIXA" />
                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Receipt.CashRegisterText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,22,0,0" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ReceiptPaymentsText}" TextWrapping="Wrap" />
                    <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Receipt.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding QuantityText}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource InfoSurfaceBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Receipt.HasStockWarnings}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ReceiptStockWarningsText}" TextWrapping="Wrap" />
                    </Border>
                    <Button Margin="0,22,0,0" Height="52" Command="{Binding NewSaleCommand}"
                            Content="Nova venda" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
