<UserControl x:Class="Girofy.Desktop.Views.SalesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="SalesView_PreviewKeyDown">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Vendas" />
                        <TextBlock Margin="0,4,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Abra uma nova venda em janela separada e finalize o pagamento em outra etapa." />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="150" Height="46"
                            Command="{Binding OpenSaleEditorCommand}"
                            Content="Nova venda" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <Border Grid.Row="2" Padding="12" Background="{StaticResource ErrorSurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="4" Padding="12" Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="6" Padding="28" Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Venda rápida" />
                            <TextBlock Margin="0,6,0,0" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Clique em Nova venda para abrir o pedido em uma janela dedicada." />
                            <TextBlock Margin="0,10,0,0" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding CartSummary}" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="170" Height="50"
                                VerticalAlignment="Center"
                                Command="{Binding OpenSaleEditorCommand}"
                                Content="Iniciar venda" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Row="6" Padding="28" Background="{StaticResource SuccessSurfaceBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Text="Venda concluída" />
                        <TextBlock Margin="0,5,0,22" HorizontalAlignment="Center" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Receipt.SaleNumberText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TOTAL" />
                                <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" Text="{Binding Receipt.FinalAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="PAGO" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Receipt.PaidAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TROCO" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoBrush}" Text="{Binding Receipt.ChangeAmountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="CAIXA" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Receipt.CashRegisterText}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,22,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ReceiptPaymentsText}" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Receipt.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding QuantityText}" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource InfoSurfaceBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Receipt.HasStockWarnings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding ReceiptStockWarningsText}" TextWrapping="Wrap" />
                        </Border>
                        <Button Margin="0,22,0,0" Height="52" Command="{Binding NewSaleCommand}"
                                Content="Nova venda" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Background="#B8000914">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSaleEditorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Margin="32" Padding="24" MaxWidth="1180" MaxHeight="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductStepOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="25" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Nova venda" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Pesquise os produtos, informe a quantidade e monte o pedido." />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="110" Height="42"
                                        Command="{Binding CloseSaleEditorCommand}"
                                        Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <Border Grid.Row="2" Padding="16" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Adicionar produto" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProductSearchInput"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Buscar produto por nome ou código de barras"
                                                 PreviewKeyDown="ProductSearchInput_PreviewKeyDown"
                                                 Style="{StaticResource TextInputStyle}" />
                                        <Button Grid.Column="2" MinWidth="112" Command="{Binding SearchCommand}"
                                                Content="Pesquisar" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                    <DataGrid x:Name="SearchResultsGrid"
                                              Grid.Row="4" MaxHeight="165"
                                              ItemsSource="{Binding SearchResults}"
                                              SelectedItem="{Binding SelectedSearchProduct}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" SelectionMode="Single"
                                              PreviewKeyDown="SearchResultsGrid_PreviewKeyDown"
                                              EnableRowVirtualization="True"
                                              Background="{StaticResource SurfaceBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              VerticalGridLinesBrush="Transparent"
                                              RowBackground="{StaticResource SurfaceBrush}"
                                              RowHeight="42" ColumnHeaderHeight="36">
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="1.1*" />
                                            <DataGridTextColumn Header="Preço" Binding="{Binding SalePriceText}" Width="1*" />
                                            <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.9*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                       Text="PRODUTO SELECIONADO" />
                                            <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding SelectedSearchProduct.Name, TargetNullValue='Selecione um resultado'}" />
                                        </StackPanel>
                                        <TextBox x:Name="QuantityInput"
                                                 Grid.Column="2" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Quantidade" Style="{StaticResource TextInputStyle}" />
                                        <Button Grid.Column="4" MinWidth="112" Command="{Binding AddProductCommand}"
                                                Content="Adicionar" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Padding="16" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Itens do pedido" />
                                    <DataGrid Grid.Row="2" MinHeight="112" MaxHeight="250"
                                              ItemsSource="{Binding CartItems}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" SelectionMode="Single"
                                              EnableRowVirtualization="True"
                                              Background="{StaticResource SurfaceBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              VerticalGridLinesBrush="Transparent"
                                              RowBackground="{StaticResource SurfaceBrush}"
                                              AlternatingRowBackground="#102034"
                                              RowHeight="54" ColumnHeaderHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Unitário" Binding="{Binding UnitPriceText}" Width="1*" />
                                            <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.8*" />
                                            <DataGridTemplateColumn Header="Quantidade" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Width="34" Height="32" Content="-"
                                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                            <TextBlock Width="54" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" TextAlignment="Center"
                                                                       FontWeight="SemiBold" Text="{Binding Quantity}" />
                                                            <Button Width="34" Height="32" Content="+"
                                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Subtotal" Binding="{Binding LineTotalText}" Width="1*" />
                                            <DataGridTemplateColumn Header="Ação" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Height="32" Content="Remover"
                                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="TOTAL DO PEDIDO" />
                                    <TextBlock Margin="0,3,0,0" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" Text="{Binding TotalText}" />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="190" Height="52"
                                        Command="{Binding OpenPaymentStepCommand}"
                                        Content="Ir para pagamento" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentStepVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="25" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Finalizar venda" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Informe uma ou mais formas de pagamento e confirme o pedido." />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="150" Height="42"
                                        Command="{Binding BackToProductsCommand}"
                                        Content="Voltar aos itens" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="3" MinWidth="100" Height="42"
                                        Command="{Binding CloseSaleEditorCommand}"
                                        Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <Border Padding="18" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Desconto" />
                                                <Button Height="42"
                                                        Command="{Binding OpenDiscountPopupCommand}"
                                                        Click="OpenDiscountPopupButton_Click"
                                                        Content="Aplicar desconto"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBlock Margin="0,6,0,0" FontSize="12"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="Atual: " />
                                                    <Run Text="{Binding DiscountPercentText}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Dinheiro" />
                                                <TextBox x:Name="MoneyInput"
                                                         Tag="money"
                                                         GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                         PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                         Text="{Binding MoneyText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource TextInputStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Pix" />
                                                <TextBox x:Name="PixInput"
                                                         Tag="pix"
                                                         GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                         PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                         Text="{Binding PixText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource TextInputStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Débito" />
                                                <TextBox x:Name="DebitInput"
                                                         Tag="debit"
                                                         GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                         PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                         Text="{Binding DebitText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource TextInputStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="4">
                                            <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="Crédito" />
                                            <TextBox x:Name="CreditInput"
                                                     Tag="credit"
                                                     GotKeyboardFocus="PaymentTextBox_GotKeyboardFocus"
                                                     PreviewKeyDown="PaymentTextBox_PreviewKeyDown"
                                                     Text="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextInputStyle}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Row="6">
                                            <Button MinWidth="132" Margin="0,0,8,8" Command="{Binding FillMoneyCommand}"
                                                    Content="Completar dinheiro" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button MinWidth="112" Margin="0,0,8,8" Command="{Binding FillPixCommand}"
                                                    Content="Completar Pix" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button MinWidth="132" Margin="0,0,8,8" Command="{Binding FillDebitCommand}"
                                                    Content="Completar débito" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button MinWidth="132" Margin="0,0,8,8" Command="{Binding FillCreditCommand}"
                                                    Content="Completar crédito" Style="{StaticResource SecondaryButtonStyle}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Padding="20" Background="{StaticResource InfoSurfaceBrush}"
                                        BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Subtotal" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Desconto" />
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DiscountAmountText}" />
                                                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="12"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding DiscountPercentText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="Total" />
                                            <TextBlock Grid.Column="1" FontSize="30" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Text="{Binding TotalText}" />
                                        </Grid>
                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Pago" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding PaidAmountText}" />
                                        </Grid>
                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Falta" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Text="{Binding MissingAmountText}" />
                                        </Grid>
                                        <Grid Grid.Row="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Troco" />
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Text="{Binding ChangeAmountText}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Button Grid.Row="4" Height="54" Command="{Binding FinalizeCommand}"
                                    Content="Finalizar pedido" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Background="#CC000914">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDiscountPopupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Margin="24" Padding="24" MaxWidth="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Aplicar desconto" />
                        <TextBlock Margin="0,4,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Informe o desconto em reais. A porcentagem é calculada automaticamente." />
                    </StackPanel>

                    <Border Grid.Row="2" Padding="16" Background="{StaticResource InfoSurfaceBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Subtotal" />
                                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SubtotalText}" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Total com desconto" />
                                <TextBlock Grid.Column="1" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding DraftTotalAfterDiscountText}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Valor do desconto" />
                        <TextBox x:Name="DiscountPopupInput"
                                 Text="{Binding DraftDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="DiscountPopupInput_PreviewKeyDown"
                                 Style="{StaticResource TextInputStyle}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Percentual aplicado: " />
                            <Run FontWeight="Bold" Text="{Binding DraftDiscountPercentText}" />
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Height="46"
                                Command="{Binding CloseDiscountPopupCommand}"
                                Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Height="46"
                                Command="{Binding ApplyDiscountCommand}"
                                Content="Aplicar desconto"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
