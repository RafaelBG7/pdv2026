                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Organização atual dos produtos da adega." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button MinWidth="132" Command="{Binding Catalog.OpenNewCategoryCommand}"
                                        Content="Nova categoria" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="126"
                                        Command="{Binding Catalog.OpenEditCategoryCommand}"
                                        Content="Editar" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="126"
                                        Command="{Binding Catalog.DeleteCategoryCommand}"
                                        Content="Excluir" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="10,0,0,0" MinWidth="112" Command="{Binding Catalog.RefreshCommand}"
                                        Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" Padding="14"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                            <Grid behaviors:EnterCommandBehavior.Command="{Binding Catalog.SearchCategoriesCommand}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Buscar categoria" />
                                    <TextBox Text="{Binding Catalog.CategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Digite o nome da categoria"
                                             Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="112" VerticalAlignment="Bottom"
                                        Command="{Binding Catalog.SearchCategoriesCommand}"
                                        Content="Pesquisar" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Column="4" MinWidth="96" VerticalAlignment="Bottom"
                                        Command="{Binding Catalog.ClearCategorySearchCommand}"
                                        Content="Limpar" Style="{StaticResource SecondaryButtonStyle}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Margin="0,9,0,0"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Text="{Binding Catalog.ErrorMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Catalog.HasError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid Grid.RowSpan="5" Panel.ZIndex="20"
                              Background="{DynamicResource OverlaySoftBrush}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Catalog.IsCategoryEditorOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border Width="560" Margin="24" Padding="24" CornerRadius="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource HeroGradientBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="{DynamicResource AccessibilityBorderThickness}">
                                <Grid behaviors:EnterCommandBehavior.Command="{Binding Catalog.SaveCategoryCommand}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Catalog.CategoryEditorTitle}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="Organize os produtos cadastrando uma categoria." />
                                        </StackPanel>
                                        <Button Grid.Column="1" MinWidth="92"
                                                Command="{Binding Catalog.CloseCategoryEditorCommand}"
                                                Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Margin="0,0,0,6" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Nome da categoria" />
                                        <TextBox Text="{Binding Catalog.CategoryEditorName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}" />
                                        <TextBlock Margin="0,7,0,0" FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="Use um nome curto e fácil de identificar." />
                                    </StackPanel>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="A categoria ficará disponível no cadastro de produtos." />
                                        <Button Grid.Column="1" MinWidth="104"
                                                Command="{Binding Catalog.CloseCategoryEditorCommand}"
                                                Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="3" MinWidth="142"
                                                Command="{Binding Catalog.SaveCategoryCommand}"
                                                Content="Salvar categoria" Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Catalog.CategorySummary}" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Catalog.CategoryRows}"
                                  SelectedItem="{Binding Catalog.SelectedCategoryRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column" EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Background="{DynamicResource SurfaceRaisedBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  VerticalGridLinesBrush="Transparent"
                                  RowBackground="{DynamicResource SurfaceRaisedBrush}"
                                  AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                                  RowHeight="50" ColumnHeaderHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Produtos" Binding="{Binding ProductCount}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="NotificationsPanel"
                  Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="200"
                  Margin="0,82,190,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Visibility="Collapsed">
                <views:NotificationsPopoverView DataContext="{Binding Notifications}" />
            </Grid>
        </Grid>
        <Grid Panel.ZIndex="300" Background="{DynamicResource OverlaySoftBrush}"
              IsVisibleChanged="ProductDeleteConfirmation_IsVisibleChanged">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Catalog.IsDeleteConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="560" MaxWidth="560" Margin="24" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="16" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="14" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource ErrorSurfaceBrush}">
                            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource ErrorBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M9,3 H15 M4,6 H20 M7,6 L8,21 H16 L17,6 M10,10 V17 M14,10 V17" />
                            </Canvas></Viewbox>
                        </Border>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Excluir produto" />
                        <Button Grid.Column="3" Width="38" Height="38" Padding="0"
                                Command="{Binding Catalog.CancelDeleteProductCommand}"
                                AutomationProperties.Name="Fechar confirmação de exclusão"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <Viewbox Width="14" Height="14"><Canvas Width="16" Height="16">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,3 L13,13 M13,3 L3,13" />
                            </Canvas></Viewbox>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="2" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="Tem certeza de que deseja excluir &quot;" />
                        <Run FontWeight="Bold" Text="{Binding Catalog.DeleteConfirmationProductName, Mode=OneWay}" />
                        <Run Text="&quot;?" />
                    </TextBlock>
                    <TextBlock Grid.Row="4" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="Produtos com vendas ou usados como base de kit não podem ser excluídos. Nesse caso, inative o produto." />
                    <Border Grid.Row="6" Padding="11" Background="{DynamicResource ErrorSurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <Border.Style><Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Catalog.HasDeleteConfirmationError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Catalog.DeleteConfirmationError}" TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelProductDeleteButton" Grid.Column="1" MinWidth="112"
                                Command="{Binding Catalog.CancelDeleteProductCommand}"
                                Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                IsTabStop="True" TabIndex="0" />
                        <Button Grid.Column="3" MinWidth="150" Command="{Binding Catalog.DeleteProductCommand}"
                                Content="{Binding Catalog.DeleteProductButtonText}"
                                Style="{StaticResource DangerButtonStyle}" IsTabStop="True" TabIndex="1" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Panel.ZIndex="100"
              Background="{DynamicResource OverlaySoftBrush}"
              PreviewKeyDown="HandleForgotPasswordKeyDown">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Login.ForgotPassword.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="460" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Recuperar senha" />
                    <TextBlock Margin="0,8,0,20"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Informe seu usuário ou e-mail. Enviaremos um link para redefinir sua senha."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,7" FontWeight="{DynamicResource FontWeightStrong}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Usuário ou e-mail" />
                    <TextBox x:Name="ForgotPasswordIdentifierInput"
                             Text="{Binding Login.ForgotPassword.Identifier, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextInputStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Login.ForgotPassword.IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Border Margin="0,16,0,0" Padding="12"
                            Background="{DynamicResource ErrorSurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Login.ForgotPassword.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Login.ForgotPassword.ErrorMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Border Margin="0,16,0,0" Padding="12"
                            Background="{DynamicResource SuccessSurfaceBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Login.ForgotPassword.IsSuccess}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Login.ForgotPassword.SuccessMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding Login.ForgotPassword.CancelCommand}"
                                Content="Voltar" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" IsDefault="True"
                                Command="{Binding Login.ForgotPassword.SubmitCommand}"
                                Content="{Binding Login.ForgotPassword.SubmitButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Erros do catálogo permanecem visíveis sobre cadastro/edição de produto
             e categoria, em vez de ficarem escondidos na tela de fundo. -->
        <Border Panel.ZIndex="190" Margin="28,22,28,0" Padding="14,12"
                MaxWidth="920" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource ErrorSurfaceBrush}"
                BorderBrush="{DynamicResource ErrorBorderBrush}"
                BorderThickness="{DynamicResource AccessibilityBorderThickness}"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Catalog.HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15"
                        Background="{DynamicResource ErrorBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="White" Text="!" />
                </Border>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding Catalog.ErrorMessage}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
