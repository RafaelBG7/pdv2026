<UserControl x:Class="Girofy.Desktop.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Girofy.Application.Models;assembly=Girofy.Application">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="27" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Text="Auditoria" />
                <TextBlock Margin="0,4,0,0" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Acompanhe ações críticas registradas na adega." />
            </StackPanel>
            <Button Grid.Column="1" MinWidth="112"
                    Command="{Binding RefreshCommand}"
                    Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <Border Grid.Row="2" Padding="12" Background="{StaticResource ErrorSurfaceBrush}"
                BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <UniformGrid Grid.Row="4" Columns="3">
            <Border Margin="0,0,10,0" Padding="16" CornerRadius="8"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="EVENTOS" />
                    <TextBlock Margin="0,5,0,0" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Summary.CountText}" />
                </StackPanel>
            </Border>
            <Border Margin="5,0" Padding="16" CornerRadius="8"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="USUÁRIOS" />
                    <TextBlock Margin="0,5,0,0" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Summary.UsersText}" />
                </StackPanel>
            </Border>
            <Border Margin="10,0,0,0" Padding="16" CornerRadius="8"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="AÇÕES" />
                    <TextBlock Margin="0,5,0,0" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Summary.ActionsText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="6" Padding="14" CornerRadius="8"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Busca" />
                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Usuário" />
                    <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Ação" />
                    <TextBlock Grid.Column="6" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Módulo" />
                    <TextBlock Grid.Column="8" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Método" />

                    <TextBox Grid.Row="2"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Buscar auditoria"
                             Style="{StaticResource TextInputStyle}" />
                    <ComboBox Grid.Row="2" Grid.Column="2" Height="48" Padding="10,0"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              DisplayMemberPath="Label" />
                    <ComboBox Grid.Row="2" Grid.Column="4" Height="48" Padding="10,0"
                              ItemsSource="{Binding Actions}"
                              SelectedItem="{Binding SelectedAction}"
                              DisplayMemberPath="Label" />
                    <ComboBox Grid.Row="2" Grid.Column="6" Height="48" Padding="10,0"
                              ItemsSource="{Binding Entities}"
                              SelectedItem="{Binding SelectedEntity}"
                              DisplayMemberPath="Label" />
                    <ComboBox Grid.Row="2" Grid.Column="8" Height="48" Padding="10,0"
                              ItemsSource="{Binding Methods}"
                              SelectedItem="{Binding SelectedMethod}"
                              DisplayMemberPath="Label" />

                    <TextBlock Grid.Row="4" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Data inicial" />
                    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="Data final" />

                    <TextBox Grid.Row="4" Margin="0,24,0,0"
                             Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Data inicial"
                             Style="{StaticResource TextInputStyle}" />
                    <TextBox Grid.Row="4" Grid.Column="2" Margin="0,24,0,0"
                             Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Data final"
                             Style="{StaticResource TextInputStyle}" />
                    <Button Grid.Row="4" Grid.Column="4" Margin="0,24,0,0"
                            Command="{Binding SearchCommand}"
                            Content="Filtrar" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Grid.Row="4" Grid.Column="6" Margin="0,24,0,0"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Limpar" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Logs}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeRows="False" SelectionMode="Single"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="Transparent"
                          RowBackground="{StaticResource SurfaceRaisedBrush}"
                          AlternatingRowBackground="#102034"
                          RowHeight="56" ColumnHeaderHeight="42">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data e hora" Binding="{Binding CreatedAtText}" Width="145" />
                        <DataGridTextColumn Header="Usuário" Binding="{Binding UserNameText}" Width="125" />
                        <DataGridTextColumn Header="Ação" Binding="{Binding ActionText}" Width="170" />
                        <DataGridTextColumn Header="Módulo" Binding="{Binding EntityText}" Width="130" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Entidade" Binding="{Binding EntityIdText}" Width="90" />
                        <DataGridTextColumn Header="IP" Binding="{Binding IpText}" Width="110" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate DataType="{x:Type models:AuditLogRecord}">
                            <Border Margin="10,0,10,12" Padding="14" CornerRadius="8"
                                    Background="{StaticResource InfoSurfaceBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}" Text="ANTES" />
                                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding OldValuesText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}" Text="DEPOIS" />
                                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding NewValuesText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <UniformGrid Grid.Row="2" Grid.ColumnSpan="3" Columns="4">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedBrush}" Text="ROTA" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedBrush}" Text="MÉTODO" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding MethodText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedBrush}" Text="REQUEST ID" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding RequestText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedBrush}" Text="IP" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding IpText}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="6" Margin="0,136,0,52" Padding="18" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Nenhum evento de auditoria encontrado." />
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding PageSummary}" />
            <Button Grid.Column="1" MinWidth="92"
                    IsEnabled="{Binding CanGoPrevious}"
                    Command="{Binding PreviousPageCommand}"
                    Content="Anterior" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="3" MinWidth="92"
                    IsEnabled="{Binding CanGoNext}"
                    Command="{Binding NextPageCommand}"
                    Content="Próxima" Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
