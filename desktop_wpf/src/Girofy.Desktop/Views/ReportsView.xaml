<UserControl x:Class="Girofy.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReportTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource AccessibilityBorderThickness}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReportMetricButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MetricBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MetricBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Relatórios" />
                    <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Acompanhe vendas, descontos, pagamentos e lucro por período." />
                    <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                        <Button Command="{Binding ShowSummaryTabCommand}"
                                Content="Resumo geral">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="10,0,0,0"
                                Command="{Binding ShowProductsTabCommand}"
                                Content="Por produto">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductsTabSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border Grid.Row="2" Padding="12"
                    Background="{DynamicResource ErrorSurfaceBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="4" Padding="18"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Filtros do período" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Período" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding PeriodOptions}"
                                      SelectedItem="{Binding SelectedPeriod}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Gráfico" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding MetricOptions}"
                                      SelectedItem="{Binding SelectedMetric}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Data inicial" />
                            <TextBox Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="AAAA-MM-DD"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Data final" />
                            <TextBox Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="AAAA-MM-DD"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>

                        <Button Grid.Row="2" Grid.ColumnSpan="7" MinWidth="150"
                                Command="{Binding ApplyFiltersCommand}"
                                Content="Aplicar filtros"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="6" Columns="4">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="VENDAS" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Summary.SalesCountText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Summary.ItemsCountText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="FATURAMENTO" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Text="{Binding Summary.FinalText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Summary.SubtotalText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="LUCRO" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding Summary.ProfitText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Summary.DiscountText}" />
                    </StackPanel>
                </Border>
                <Border Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="TICKET MÉDIO" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Summary.AverageTicketText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Grid.Row="8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <UniformGrid Columns="3">
                    <Border Margin="0,0,8,0" Padding="16"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="3,1,1,1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Horário de pico" />
                            <TextBlock Margin="0,7,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Snapshot.Chart.Peak.Title, TargetNullValue=Sem vendas}" />
                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Snapshot.Chart.PeakText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0" Padding="16"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Melhor período em quantidade" />
                            <TextBlock Margin="0,7,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Snapshot.Chart.PeakByQuantity.Title, TargetNullValue=Sem vendas}" />
                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Snapshot.Chart.QuantityPeakText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Padding="16"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Melhor período em faturamento" />
                            <TextBlock Margin="0,7,0,0" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Snapshot.Chart.PeakByRevenue.Title, TargetNullValue=Sem vendas}" />
                            <TextBlock Margin="0,5,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Snapshot.Chart.RevenuePeakText}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,14,0,0"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Vendas por horário" />
                                <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Movimentação distribuída pelos intervalos do período" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="4"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="9">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SelectRevenueMetricCommand}" Content="Faturamento">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ReportMetricButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRevenueMetricSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SelectQuantityMetricCommand}" Content="Quantidade">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ReportMetricButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQuantityMetricSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                        <ItemsControl Grid.Row="2" Margin="16,18,16,14" ItemsSource="{Binding ChartBuckets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="225" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7"
                                                ToolTip="{Binding TooltipText}">
                                            <Grid Margin="6">
                                                <Border MinHeight="4"
                                                        Height="{Binding ChartHeight}"
                                                        VerticalAlignment="Bottom"
                                                        CornerRadius="5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock x:Name="PeakLabel" Margin="0,7,0,0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                                           FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold"
                                                           Foreground="{DynamicResource OnAccentTextBrush}"
                                                           Text="Pico">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                   FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Label}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowAxisLabel}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="18"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Formas de pagamento" />
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding PaymentTotals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding AmountText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="18"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Produtos mais vendidos" />
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding TopProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="12"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="6" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding QuantityText}" />
                                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding TotalText}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Border Grid.Row="10" Padding="18"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProductsTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Relatório por produto" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding ProductSnapshot.PeriodDescription}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ProductPagination.PageText}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Produto" />
                            <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Buscar produto"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Ordenar" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding ProductSortOptions}"
                                      SelectedItem="{Binding SelectedProductSort}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <Button Grid.Column="4" MinWidth="132" Margin="0,24,0,0"
                                Command="{Binding ApplyProductFiltersCommand}"
                                Content="Aplicar"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <UniformGrid Grid.Row="4" Columns="5">
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="PRODUTOS" />
                                <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ProductSummary.ProductsText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="QUANTIDADE" />
                                <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ProductSummary.QuantityText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="FATURAMENTO" />
                                <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource InfoBrush}"
                                           Text="{Binding ProductSummary.RevenueText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="CUSTO" />
                                <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ProductSummary.CostText}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeTiny}" FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="LUCRO" />
                                <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Text="{Binding ProductSummary.ProfitText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="6" ItemsSource="{Binding ProductRows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserResizeRows="False" SelectionMode="Single"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Background="{DynamicResource SurfaceRaisedBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="Transparent"
                              RowBackground="{DynamicResource SurfaceRaisedBrush}"
                          AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                              RowHeight="54" ColumnHeaderHeight="42">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="1.8*" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="1.1*" />
                            <DataGridTextColumn Header="Vendido" Binding="{Binding QuantityText}" Width="0.8*" />
                            <DataGridTextColumn Header="Faturamento" Binding="{Binding RevenueText}" Width="1*" />
                            <DataGridTextColumn Header="Custo" Binding="{Binding CostText}" Width="0.9*" />
                            <DataGridTextColumn Header="Lucro" Binding="{Binding ProfitText}" Width="0.9*" />
                            <DataGridTextColumn Header="Ticket" Binding="{Binding AverageTicketText}" Width="0.9*" />
                            <DataGridTextColumn Header="Estoque" Binding="{Binding StockText}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button MinWidth="118"
                                Command="{Binding PreviousProductPageCommand}"
                                Content="Anterior"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ProductPagination.PageText}" />
                        <Button Grid.Column="2" MinWidth="118"
                                Command="{Binding NextProductPageCommand}"
                                Content="Próxima"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
