<UserControl x:Class="Girofy.Desktop.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Notificações"/><TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="Alertas operacionais e administrativos da sua adega."/></StackPanel>
            <Button Grid.Column="1" Command="{Binding MarkAllReadCommand}" Content="Marcar todas como lidas" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Grid.Column="3" Command="{Binding RefreshCommand}" Content="Atualizar" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
        <Border Grid.Row="2" Padding="14" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar notificações" Style="{StaticResource TextInputStyle}"/>
                <ComboBox Grid.Column="2" SelectedValue="{Binding Category}" SelectedValuePath="Tag"><ComboBoxItem Tag="" Content="Todas as categorias"/><ComboBoxItem Tag="stock" Content="Estoque"/><ComboBoxItem Tag="payables" Content="Contas"/><ComboBoxItem Tag="cash_register" Content="Caixa"/><ComboBoxItem Tag="sales" Content="Vendas"/><ComboBoxItem Tag="security" Content="Segurança"/></ComboBox>
                <ComboBox Grid.Column="4" SelectedValue="{Binding Severity}" SelectedValuePath="Tag"><ComboBoxItem Tag="" Content="Todas severidades"/><ComboBoxItem Tag="info" Content="Informação"/><ComboBoxItem Tag="success" Content="Sucesso"/><ComboBoxItem Tag="warning" Content="Atenção"/><ComboBoxItem Tag="critical" Content="Crítica"/></ComboBox>
                <Button Grid.Column="6" Command="{Binding ApplyFiltersCommand}" Content="Filtrar" Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Carregando notificações..."/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock MaxWidth="520" Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorMessage}" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Margin="0,12,0,0" Command="{Binding RefreshCommand}" Content="Tentar novamente" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="Nenhuma notificação encontrada.">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasNoItems}" Value="True"/><Condition Binding="{Binding HasError}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Margin="0,0,0,10" Padding="16" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="10" Background="{StaticResource InfoBrush}" CornerRadius="5"/>
                        <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}"/><Border Margin="10,0,0,0" Padding="8,3" Background="{StaticResource InfoSurfaceBrush}" CornerRadius="8"><TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SeverityText}"/></Border></StackPanel><TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding CategoryText}"/><Run Text=" • "/><Run Text="{Binding CreatedAtText}"/><Run Text=" • "/><Run Text="{Binding ReadText}"/></TextBlock></StackPanel>
                        <StackPanel Grid.Column="3"><Button Margin="0,0,0,7" Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Marcar como lida" Style="{StaticResource SecondaryButtonStyle}"/><Button Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Dispensar" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Grid>
    </Grid>
</UserControl>
