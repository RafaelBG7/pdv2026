                                                        <Border Margin="0,0,10,8" Padding="10,7"
                                                                Background="{StaticResource InfoSurfaceBrush}"
                                                                BorderBrush="{StaticResource InfoBorderBrush}"
                                                                BorderThickness="1" CornerRadius="5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Text="{Binding Label}" />
                                                                <TextBlock Margin="8,0,0,0" FontWeight="Bold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           Text="{Binding AmountText}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
