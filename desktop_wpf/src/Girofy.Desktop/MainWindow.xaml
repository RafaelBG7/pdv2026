                                                            <DataTrigger Binding="{Binding Catalog.IsKitComponentSuggestionsOpen}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <ListBox x:Name="KitComponentSuggestionsList"
