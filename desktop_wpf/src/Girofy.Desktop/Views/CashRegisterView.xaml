                                    BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Carregando detalhes do caixa...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDetailLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding DetailRegister.NumberText}" />
