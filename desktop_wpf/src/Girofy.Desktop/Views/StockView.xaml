<UserControl x:Class="Girofy.Desktop.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource FontSizePageTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Estoque" />
                    <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Acompanhe entradas, saídas, ajustes, vendas e importações." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="108"
                        Command="{Binding RefreshCommand}"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Padding="12" Margin="0,0,0,8"
                        Background="{DynamicResource ErrorSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Padding="12"
                        Background="{DynamicResource SuccessSurfaceBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Margin="0,0,0,2" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button MinWidth="150" Height="42" Command="{Binding ShowMovementsTabCommand}"
                            Content="Movimentações">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovementsTabSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button MinWidth="178" Height="42" Margin="8,0,0,0"
                            Command="{Binding ShowManualEntriesTabCommand}"
                            Content="Lançamentos manuais"
                            IsEnabled="{Binding CanManageStock}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManualEntriesTabSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="6" Columns="4">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMovementsTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="ENTRADAS NO PERÍODO" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding Summary.EntriesText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="SAÍDAS NO PERÍODO" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Text="{Binding Summary.ExitsText}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="MOVIMENTAÇÕES" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Summary.MovementCountText}" />
                    </StackPanel>
                </Border>
                <Border Padding="16"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource FontSizeSmall}" FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="PRODUTOS MOVIMENTADOS" />
                        <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Text="{Binding Summary.ProductCountText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="8" Padding="18"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMovementsTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Consulta de movimentações" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Produto, motivo ou observação" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Buscar movimentação"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Categoria" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Tipo" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding MovementTypes}"
                                      SelectedItem="{Binding SelectedMovementType}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Origem" />
                            <ComboBox Height="48" Padding="10,0"
                                      ItemsSource="{Binding SourceTypes}"
                                      SelectedItem="{Binding SelectedSourceType}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>

                        <Button Grid.Row="2" Grid.ColumnSpan="3" MinWidth="150"
                                Command="{Binding SearchCommand}"
                                Content="Filtrar"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" MinWidth="150"
                                Command="{Binding RefreshCommand}"
                                Content="Limpar e atualizar"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="8" Padding="18"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanManageStock}" Value="True" />
                                    <Condition Binding="{Binding IsManualEntriesTabSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Lançamentos manuais" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Text="Entrada de estoque" />
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Buscar produto"
                                             Style="{StaticResource TextInputStyle}" />
                                    <Button Grid.Column="2" MinWidth="104"
                                            Command="{Binding SearchProductsCommand}"
                                            Content="Buscar"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <ComboBox Grid.Row="4" Height="48" Padding="10,0"
                                          ItemsSource="{Binding ProductOptions}"
                                          SelectedItem="{Binding EntryProduct}"
                                          DisplayMemberPath="Name" />
                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Quantidade" />
                                        <TextBox Text="{Binding EntryQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Custo unitário" />
                                        <TextBox Text="{Binding EntryUnitCostText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="8">
                                    <CheckBox Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              Content="Atualizar custo do produto"
                                              IsChecked="{Binding EntryUpdateCost}" />
                                    <TextBox Text="{Binding EntryReason, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Motivo"
                                             Style="{StaticResource TextInputStyle}" />
                                    <TextBox Margin="0,10,0,0"
                                             Text="{Binding EntryNotes, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Observações"
                                             Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Row="10" Command="{Binding RegisterEntryCommand}"
                                        Content="Registrar entrada"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource InfoBrush}"
                                           Text="Ajuste de estoque" />
                                <ComboBox Grid.Row="2" Height="48" Padding="10,0"
                                          ItemsSource="{Binding ProductOptions}"
                                          SelectedItem="{Binding AdjustmentProduct}"
                                          DisplayMemberPath="Name" />
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Height="48" Padding="10,0"
                                              ItemsSource="{Binding AdjustmentModes}"
                                              SelectedItem="{Binding SelectedAdjustmentMode}"
                                              DisplayMemberPath="Label" />
                                    <ComboBox Grid.Column="2" Height="48" Padding="10,0"
                                              ItemsSource="{Binding AdjustmentDirections}"
                                              SelectedItem="{Binding SelectedAdjustmentDirection}"
                                              DisplayMemberPath="Label" />
                                </Grid>
                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Estoque final" />
                                        <TextBox Text="{Binding AdjustmentTargetStockText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Margin="0,0,0,6" FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Quantidade" />
                                        <TextBox Text="{Binding AdjustmentQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextInputStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="8">
                                    <TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Motivo"
                                             Style="{StaticResource TextInputStyle}" />
                                    <TextBox Margin="0,10,0,0"
                                             Text="{Binding AdjustmentNotes, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Observações"
                                             Style="{StaticResource TextInputStyle}" />
                                </StackPanel>
                                <Button Grid.Row="10" Command="{Binding RegisterAdjustmentCommand}"
                                        Content="Registrar ajuste"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="10" Padding="0"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMovementsTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="18,14" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Histórico de movimentações" />
                                <TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Entradas, saídas, ajustes, vendas e importações." />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="10,5" VerticalAlignment="Center"
                                    Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="{DynamicResource AccessibilityBorderThickness}" CornerRadius="5">
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource InfoBrush}"
                                           Text="{Binding PageSummary}" />
                            </Border>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Movements}"
                              MaxHeight="560"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="{DynamicResource SurfaceBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="Transparent"
                              RowBackground="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                              RowHeight="52"
                              ColumnHeaderHeight="40">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,1,0,1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data e hora" Binding="{Binding CreatedAtText}" Width="1.15*" />
                            <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="1.8*" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="1.2*" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding MovementTypeLabel}" Width="0.95*" />
                            <DataGridTextColumn Header="Origem" Binding="{Binding SourceTypeLabel}" Width="0.95*" />
                            <DataGridTextColumn Header="Qtd." Binding="{Binding QuantityText}" Width="0.75*" />
                            <DataGridTextColumn Header="Anterior" Binding="{Binding PreviousStockText}" Width="0.8*" />
                            <DataGridTextColumn Header="Posterior" Binding="{Binding NewStockText}" Width="0.8*" />
                            <DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="0.9*" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding PageSummary}" />
                        <Button Grid.Column="2" MinWidth="92"
                                Command="{Binding PreviousPageCommand}"
                                Content="Anterior"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="4" MinWidth="92"
                                Command="{Binding NextPageCommand}"
                                Content="Próxima"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
